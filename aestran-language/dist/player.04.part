('Refreshing Aestra…');
    const ok=await connectLiveCampaign();
    if(ok)$('snapshotStatus').textContent=`Live sync refreshed · v${SNAP.publishedVersion||'—'}.`;
  };
  if(!window.supabase?.createClient){
    liveJoined=false;liveStatus('Live archive unavailable. Using the last saved copy on this device.','warn');return;
  }
  liveClient=window.supabase.createClient(LIVE_CONFIG.url,LIVE_CONFIG.publishableKey,{auth:{persistSession:false,autoRefreshToken:false,detectSessionInUrl:false}});
  await connectLiveCampaign();
}
const rootMap=()=>Object.fromEntries(SNAP.roots.map(x=>[x.id,x])),compoundMap=()=>Object.fromEntries(SNAP.compounds.map(x=>[x.id,x]));
function knownRoots(){return SNAP.roots.filter(r=>r.discovered!==false&&((r.meanings||[]).length||(r.suspected||[]).length))}
function knownCompounds(){return SNAP.compounds.filter(c=>c.known)}
function runePath(id){return rootMap()[id]?.svgPath||compoundMap()[id]?.canonicalPath||''}
function runeSVG(id,size=72){const p=runePath(id);return `<svg viewBox="0 0 100 100" style="width:${size}px;height:${size}px" aria-label="${esc(id)} glyph"><path d="${esc(p)}"/></svg>`}
function rootReading(id){const r=rootMap()[id];if(!r)return '???';if((r.meanings||[]).length)return r.meanings[0];if((r.suspected||[]).length)return r.suspected[0]+' ?';return '???'}
const REL={inside:'inside',surrounding:'around',above:'above',below:'below',joined:'joined',fused:'fused with',crossed:'crossing',mirrored:'mirrored with',repeated:'repeated with'};
function treeReading(node){if(typeof node==='string'){const c=compoundMap()[node];if(c?.known)return node.toLowerCase();const r=rootMap()[node];if(r)return rootReading(node);if(c)return treeReading(c.tree);return '???'}if(!node||typeof node!=='object'||!node.rel)return '???';return `${treeReading(node.a)} ${REL[node.rel]||node.rel} ${treeReading(node.b)}`}
function conceptReading(id){const r=rootMap()[id];if(r)return rootReading(id);const c=compoundMap()[id];if(!c)return '???';return c.known?id.toLowerCase():treeReading(c.tree)}
function renderUnits(units){return `<div class="glyphline">${(units||[]).map(id=>`<div class="glyphcard">${runeSVG(id,72)}</div>`).join('')}</div>`}
function showScreen(id){
  const meta={archive:['Inscription archive','Recovered inscriptions change as your understanding grows.'],discoveries:['Discoveries','The language remembers each moment of understanding.'],lexicon:['Party lexicon','Every sign the party can currently recognise.'],draw:['Glyph analysis','Draw, analyse and practise known Aestran signs.']}[id];
  if(!meta)return;
  if(id!=='draw'&&typeof cancelGoldRetrace==='function'){
    clearPracticeTimer();
    if(randomReferenceActive){randomReferenceActive=false;randomReferenceTarget=null;resetDrawingState();setDrawMode('Free draw',freeDrawModeCopy(),'good');$('drawResult').innerHTML='Draw something first.';$('drawResultCard').classList.remove('answered')}
    else if(practicePhase==='demo'){practicePhase='idle';practiceTarget=null;setPracticeDemoControls(false);resetDrawingState();setDrawMode('Free draw',freeDrawModeCopy(),'good');$('drawResult').innerHTML='Draw something first.';$('drawResultCard').classList.remove('answered')}
    else if(analysisInProgress){analysisInProgress=false;cancelGoldRetrace();if(practicePhase==='draw'&&practiceTarget)setDrawMode('Practice · Your turn','Keep refining <b>'+esc(practiceTarget.id)+'</b>, then analyse again when you are ready.','good');else setDrawMode('Free draw',freeDrawModeCopy(),'good')}
    else cancelGoldRetrace();
  }
  document.querySelectorAll('.screen').forEach(x=>x.classList.toggle('active',x.id===id));document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('active',x.dataset.screen===id));$('pageTitle').textContent=meta[0];$('pageSub').textContent=meta[1];if(id==='lexicon')startBubbles();else stopBubbles();window.scrollTo({top:0,behavior:'smooth'})
}
document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>showScreen(b.dataset.screen));
function renderArchive(){const list=$('archiveList'),items=SNAP.inscriptions||[];$('archiveCount').textContent=`${items.length} inscription${items.length===1?'':'s'}`;list.innerHTML=items.length?items.map(i=>`<article class="archive-item"><div class="archive-head"><div><div class="archive-title">${esc(i.title||'Recovered inscription')}</div><div class="muted" style="font-size:11px">${esc(i.style||'natural')}</div></div><span class="pill">${(i.units||[]).length} signs</span></div>${renderUnits(i.units)}<div class="reading"><h3>Decoder reading</h3><div style="margin-top:5px">${(i.units||[]).map(x=>`<span class="${conceptReading(x)==='???'?'unknown':''}">${esc(conceptReading(x))}</span>`).join(' · ')}</div></div><div class="note"><h3>Your interpretation</h3><textarea rows="2" data-note="${esc(i.id)}" placeholder="Write your interpretation…">${esc(notes[i.id]??i.playerNote??'')}</textarea><span class="note-sync" data-note-sync="${esc(i.id)}">${'Saved on this device'}</span></div></article>`).join(''):`<div class="empty" style="margin-top:16px">No inscriptions have been released to the party yet.</div>`;list.querySelectorAll('[data-note]').forEach(t=>t.oninput=()=>{notes[t.dataset.note]=t.value;saveNotes();const marker=document.querySelector(`[data-note-sync="${CSS.escape(t.dataset.note)}"]`);if(marker)marker.textContent='Saved on this device'})}
function renderDiscoveries(){const d=[...(SNAP.discoveries||[])].reverse();$('discoveryCount').textContent=`${d.length} discover${d.length===1?'y':'ies'}`;$('timeline').innerHTML=d.length?d.map(x=>`<div class="discovery"><div class="label">${esc(x.label||'New understanding')}</div><div class="muted" style="margin-top:4px">${esc(x.description||'')}</div>${(x.echoes||[]).map(e=>`<div class="echo"><b>${esc(e.title||'Archived inscription')}</b><div>${esc(e.before||'???')}</div><div style="color:var(--gold);margin:3px 0">↓</div><div>${esc(e.after||'???')}</div></div>`).join('')}</div>`).join(''):`<div class="empty">No discoveries have been recorded yet.</div>`}
function lexiconBubbleMetrics(count,stageWidth=0){
  const vw=Math.max(320,window.innerWidth||1200),width=Math.max(260,stageWidth||vw-40);
  let visual=104,hit=104,gap=10,minHeight=620,density='normal';
  if(vw<=620){
    visual=count<=12?64:count<=24?56:count<=40?50:46;
    hit=Math.max(60,visual+8);gap=2;minHeight=500;density=visual<=50?'tiny':'small';
  }else if(vw<=980){
    visual=count<=18?86:count<=34?78:70;
    hit=Math.max(78,visual+8);gap=8;minHeight=540;density=visual<=78?'small':'normal';
  }
  const cols=Math.max(vw<=620?3:4,Math.floor((width-24)/(hit+gap)));
  const rows=Math.max(1,Math.ceil(Math.max(1,count)/cols));
  const height=vw<=980?Math.max(minHeight,34+rows*(hit+gap)+24):minHeight;
  return{visual,hit,gap,cols,rows,height,density,width};
}
function clampBubble(b){
  const stage=$('bubbleStage'),r=stage.getBoundingClientRect(),w=Math.max(1,r.width),h=Math.max(1,r.height);
  b.x=Math.max(.015,Math.min(Math.max(.015,1-b.hit/w-.015),b.x));
  b.y=Math.max(.015,Math.min(Math.max(.015,1-b.hit/h-.015),b.y));
}
function applyBubbleSizing(b,metrics){
  b.visual=metrics.visual;b.hit=metrics.hit;
  b.el.style.setProperty('--bubble-visual',metrics.visual+'px');
  b.el.style.setProperty('--bubble-hit',metrics.hit+'px');
}
function defaultBubblePosition(i,count,metrics,stageWidth,stageHeight){
  const col=i%metrics.cols,row=Math.floor(i/metrics.cols),cols=Math.min(metrics.cols,Math.max(1,count)),rows=Math.max(1,Math.ceil(count/metrics.cols));
  const padX=Math.max(12,metrics.hit*.18),padY=Math.max(14,metrics.hit*.2);
  const availX=Math.max(0,stageWidth-metrics.hit-padX*2),availY=Math.max(0,stageHeight-metrics.hit-padY*2);
  const x=padX+(cols===1?availX*.5:col*(availX/Math.max(1,cols-1)))+((row%2)?Math.min(8,metrics.gap):0);
  const y=padY+(rows===1?availY*.5:row*(availY/Math.max(1,rows-1)));
  return{x:Math.max(0,Math.min(stageWidth-metrics.hit,x))/stageWidth,y:Math.max(0,Math.min(stageHeight-metrics.hit,y))/stageHeight};
}
function refreshLexiconSizing(){
  const stage=$('bubbleStage');if(!stage)return;
  const width=stage.clientWidth||stage.getBoundingClientRect().width||window.innerWidth-40,metrics=lexiconBubbleMetrics(bubbles.length,width);
  stage.style.height=metrics.height+'px';stage.dataset.density=metrics.density;
  bubbles.forEach(b=>{applyBubbleSizing(b,metrics);clampBubble(b)});positionAll();
}
function renderLexicon(){
  const known=[...knownRoots().map(r=>({id:r.id,type:'root'})),...knownCompounds().map(c=>({id:c.id,type:'word'}))];
  $('lexCount').textContent=`${known.length} known`;stopBubbles();const stage=$('bubbleStage');stage.innerHTML='';
  if(!known.length){stage.innerHTML='<div class="empty" style="position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:30px"><div><div style="font-size:32px;color:rgba(216,193,124,.28);margin-bottom:8px">◇</div><b>No signs have been understood yet.</b><div class="muted" style="margin-top:6px">The language of Aestra remains silent. Discover a glyph to begin the lexicon.</div></div></div>';}
  const stageWidth=stage.clientWidth||stage.getBoundingClientRect().width||window.innerWidth-40,metrics=lexiconBubbleMetrics(known.length,stageWidth);stage.style.height=metrics.height+'px';stage.dataset.density=metrics.density;
  const stageHeight=metrics.height;
  bubbles=known.map((item,i)=>{
    const el=document.createElement('button');el.className='bubble';el.type='button';el.dataset.id=item.id;
    el.innerHTML=`<span class="bubble-visual">${runeSVG(item.id,Math.round(metrics.visual*.62))}<span class="bubble-name">${esc(item.id)}</span></span>`;stage.appendChild(el);
    const saved=bubbleLayout[item.id],fallback=defaultBubblePosition(i,known.length,metrics,stageWidth,stageHeight);
    const state={...item,el,x:saved?.x??fallback.x,y:saved?.y??fallback.y,vx:(i%2?1:-1)*0.000025*(1+i%3),vy:(i%3?1:-1)*0.00002,pinned:!!saved?.pinned,visual:metrics.visual,hit:metrics.hit};
    applyBubbleSizing(state,metrics);clampBubble(state);el.classList.toggle('pinned',state.pinned);
    el.onclick=()=>{if(state._moved)return;selectedGlyph=item.id;renderLexDetail();bubbles.forEach(b=>b.el.classList.toggle('active',b.id===selectedGlyph))};
    el.onpointerdown=e=>{e.preventDefault();state._moved=false;const r=stage.getBoundingClientRect();drag={state,ox:e.clientX-(r.left+state.x*r.width),oy:e.clientY-(r.top+state.y*r.height)};el.classList.add('dragging');el.setPointerCapture(e.pointerId)};
    el.onpointermove=e=>{if(!drag||drag.state!==state)return;const r=stage.getBoundingClientRect(),nx=(e.clientX-r.left-drag.ox)/r.width,ny=(e.clientY-r.top-drag.oy)/r.height;state.x=nx;state.y=ny;clampBubble(state);state._moved=true;positionBubble(state)};
    el.onpointerup=()=>{if(!drag||drag.state!==state)return;el.classList.remove('dragging');if(state._moved){state.pinned=true;el.classList.add('pinned');bubbleLayout[state.id]={x:state.x,y:state.y,pinned:true};saveLayout()}setTimeout(()=>state._moved=false,0);drag=null};
    el.onpointercancel=()=>{if(drag?.state===state)drag=null;el.classList.remove('dragging')};
    return state;
  });
  positionAll();renderLexDetail();bubbles.forEach(b=>b.el.classList.toggle('active',b.id===selectedGlyph));startBubbles();
}
function positionBubble(b){const r=$('bubbleStage').getBoundingClientRect();b.el.style.left=(b.x*r.width)+'px';b.el.style.top=(b.y*r.height)+'px'}
function positionAll(){bubbles.forEach(positionBubble)}
function startBubbles(){
  if(bubbleRAF||!$('lexicon').classList.contains('active'))return;let last=performance.now();
  const tick=now=>{const dt=Math.min(30,now-last);last=now,stage=$('bubbleStage'),rect=stage.getBoundingClientRect(),w=Math.max(1,rect.width),h=Math.max(1,rect.height);
    bubbles.forEach(b=>{if(b.pinned||drag?.state===b)return;b.x+=b.vx*dt;b.y+=b.vy*dt;const maxX=Math.max(.015,1-b.hit/w-.015),maxY=Math.max(.015,1-b.hit/h-.015);if(b.x<.015||b.x>maxX)b.vx*=-1;if(b.y<.015||b.y>maxY)b.vy*=-1;b.x=Math.max(.015,Math.min(maxX,b.x));b.y=Math.max(.015,Math.min(maxY,b.y))});
    // Gentle visual collision keeps drifting fragments from piling on top of each other.
    for(let i=0;i<bubbles.length;i++)for(let j=i+1;j<bubbles.length;j++){const a=bubbles[i],b=bubbles[j],ax=a.x*w+a.hit/2,ay=a.y*h+a.hit/2,bx=b.x*w+b.hit/2,by=b.y*h+b.hit/2,dx=bx-ax,dy=by-ay,dist=Math.hypot(dx,dy)||.001,min=(a.visual+b.visual)/2+5;if(dist<min){const nx=dx/dist,ny=dy/dist,push=(min-dist)*.52;if(!a.pinned&&drag?.state!==a){a.x-=nx*push/w;a.y-=ny*push/h;clampBubble(a)}if(!b.pinned&&drag?.state!==b){b.x+=nx*push/w;b.y+=ny*push/h;clampBubble(b)}}}
    bubbles.forEach(positionBubble);bubbleRAF=requestAnimationFrame(tick)};bubbleRAF=requestAnimationFrame(tick)
}
function stopBubbles(){if(bubbleRAF)cancelAnimationFrame(bubbleRAF);bubbleRAF=null}
function renderLexDetail(){const id=selectedGlyph||knownRoots()[0]?.id||knownCompounds()[0]?.id;if(!id){$('lexDetail').innerHTML='<div class="muted">The first discovered sign wil