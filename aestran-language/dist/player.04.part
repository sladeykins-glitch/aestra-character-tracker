// Mobile lexicon density pass: adaptive visual bubbles with stable touch targets.
// Drawing / recognition — player build parity with the GM Player view.
const canvas=$('drawCanvas'),ctx=canvas.getContext('2d'),drawStage=$('drawStage');
const inkCanvas=document.createElement('canvas'),inkCtx=inkCanvas.getContext('2d');inkCanvas.width=canvas.width;inkCanvas.height=canvas.height;
const DRAW_GRID={cells:8,margin:60};
let drawStrokes=[],drawHoverPoint=null,drawDragStart=null,drawPreviewPoint=null,drawPointerId=null,drawTraceAnimation=null,drawFadeAnimation=null,drawSparks=[],practiceTarget=null,practicePhase='idle',practiceTimer=null,lastRandomRuneId=null,randomReferenceTarget=null,randomReferenceActive=false,analysisInProgress=false;
let lastAmbientFrame=0;
const cosmicStars=Array.from({length:82},()=>({x:Math.random()*canvas.width,y:Math.random()*canvas.height,r:Math.random()*1.55+.3,drift:(Math.random()-.5)*.075,fall:(Math.random()-.5)*.04,phase:Math.random()*Math.PI*2,alpha:.25+Math.random()*.5,warm:Math.random()>.84}));
function drawGridMetrics(){const size=Math.min(canvas.width,canvas.height)-DRAW_GRID.margin*2,step=size/DRAW_GRID.cells;return{x0:(canvas.width-size)/2,y0:(canvas.height-size)/2,size,step}}
function snapDrawPoint(p){const g=drawGridMetrics(),gx=Math.max(0,Math.min(8,Math.round((p.x-g.x0)/g.step))),gy=Math.max(0,Math.min(8,Math.round((p.y-g.y0)/g.step)));return{x:g.x0+gx*g.step,y:g.y0+gy*g.step,gx,gy,t:p.t}}
