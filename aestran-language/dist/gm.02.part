gba(26,31,38,.84),rgba(15,19,25,.92));box-shadow:0 18px 36px rgba(0,0,0,.18);overflow:hidden}
#playerArchiveList .archive-row:before{content:'';position:absolute;inset:0;pointer-events:none;background:
 radial-gradient(circle at 16% 12%,rgba(234,214,149,.06),transparent 16%),
 radial-gradient(circle at 85% 82%,rgba(216,193,124,.045),transparent 18%)}
#playerArchiveList .archive-row:after{content:'✦';position:absolute;right:18px;bottom:10px;color:rgba(216,193,124,.18);font-size:24px;transform:rotate(18deg)}
#playerArchiveList .glyph-card{background:rgba(10,14,19,.55);border-color:rgba(216,193,124,.1);box-shadow:inset 0 0 20px rgba(216,193,124,.025)}
#playerArchiveList .glyph-card svg{filter:drop-shadow(0 0 4px rgba(216,193,124,.08))}
#playerNotification{box-shadow:0 0 24px rgba(216,193,124,.08),inset 0 0 24px rgba(216,193,124,.04);animation:noticePulse 3.2s ease-in-out 2}

.draw-stage{transition:box-shadow .35s ease,filter .35s ease}
.draw-stage:after{content:'';position:absolute;inset:0;pointer-events:none;background:
 radial-gradient(circle at 12% 20%,rgba(255,255,255,.2),transparent 22%),
 linear-gradient(90deg,transparent,rgba(126,93,31,.025),transparent);mix-blend-mode:multiply}
.draw-stage.glowing{animation:ritualPulse 1.7s ease-in-out 2;filter:saturate(1.05)}
.draw-stage.glowing:before{animation:paperShimmer 1.6s ease-in-out 2}
.draw-stage.glowing .ink-hint{color:#6b5422}
.draw-stage.glowing .ink-hint b{color:#8e6c1f;text-shadow:0 0 10px rgba(234,214,149,.35)}
.draw-result-card{position:relative;overflow:hidden}
.draw-result-card:before{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(110deg,transparent 20%,rgba(234,214,149,.04) 45%,transparent 70%);transform:translateX(-120%)}
.draw-result-card.answered:before{animation:resultSweep 1.4s ease-out}
.draw-result-card.answered{border-color:rgba(234,214,149,.3);box-shadow:0 0 20px rgba(216,193,124,.08)}
.arcane-rune-ring{position:absolute;border:1px solid rgba(234,214,149,.08);border-radius:50%;pointer-events:none;animation:slowTurn 22s linear infinite}
/* Void-calligraphy draw canvas refresh */
.draw-stage{background:radial-gradient(circle at 50% 35%,rgba(35,41,67,.35),transparent 24%),linear-gradient(180deg,#070a12,#0a1020 58%,#06090f);border:1px solid rgba(216,193,124,.18);box-shadow:0 24px 55px rgba(0,0,0,.34),inset 0 0 0 1px rgba(255,255,255,.03);transition:box-shadow .35s ease,filter .35s ease,transform .35s ease}
.draw-stage:before{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 20% 16%,rgba(79,94,157,.11),transparent 18%),radial-gradient(circle at 80% 24%,rgba(255,218,120,.045),transparent 14%),radial-gradient(circle at 62% 74%,rgba(92,109,172,.08),transparent 18%);mix-blend-mode:screen}
.draw-stage:after{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(115deg,transparent 12%,rgba(255,233,161,.035) 34%,transparent 48%),radial-gradient(circle at 50% 50%,rgba(255,240,189,.045),transparent 40%);mix-blend-mode:screen;opacity:.9}
.calligraphy-wrap{position:relative;z-index:1;border-radius:16px;overflow:hidden}
#drawCanvas{height:420px;background:transparent;border:0;border-radius:16px;box-shadow:none}
.ink-hint{font-size:12px;color:#b9a978}.ink-hint b{color:#f0d88f;text-shadow:0 0 8px rgba(240,216,143,.16)}
.draw-stage.glowing{animation:voidPulse 1.95s ease-in-out 1;filter:saturate(1.1) brightness(1.03);box-shadow:0 24px 55px rgba(0,0,0,.34),0 0 0 1px rgba(244,214,127,.2),0 0 26px rgba(230,186,83,.12),inset 0 0 28px rgba(245,216,126,.035)}
.draw-stage.glowing:after{animation:goldSweep 1.4s ease-out 1}
@keyframes voidPulse{0%,100%{transform:translateY(0);box-shadow:0 24px 55px rgba(0,0,0,.34),0 0 0 1px rgba(244,214,127,.14),0 0 10px rgba(230,186,83,.045),inset 0 0 8px rgba(245,216,126,.016)}50%{transform:translateY(-.5px);box-shadow:0 24px 55px rgba(0,0,0,.34),0 0 0 1px rgba(244,214,127,.22),0 0 26px rgba(230,186,83,.13),inset 0 0 34px rgba(245,216,126,.05)}}
@keyframes goldSweep{0%{opacity:.35;transform:translateX(-35%)}100%{opacity:0;transform:translateX(30%)}}

/* Larger player drawing workspace + stellar stroke colour */
#draw .grid2{grid-template-columns:minmax(0,1fr) 235px;gap:22px}
#draw .card:first-child{padding:22px}
#drawCanvas{width:min(100%,720px);height:auto;min-height:0;aspect-ratio:1/1;margin:0 auto;display:block}
.draw-stage{min-height:0}
@media(max-width:1000px){#draw .grid2{grid-template-columns:1fr}}
@media(max-width:650px){#drawCanvas{width:100%;height:auto;min-height:0}.draw-stage{min-height:0;padding:12px}}

/* Player-side polish pass */
#draw .card:first-child{position:relative;overflow:hidden}
#draw .card:first-child:before{content:'';position:absolute;inset:-25% -10% auto auto;width:240px;height:240px;border-radius:50%;pointer-events:none;background:radial-gradient(circle,rgba(234,214,149,.08),transparent 65%);opacity:.8}
.draw-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-top:14px}
.draw-toolbar-group{display:flex;gap:9px;flex-wrap:wrap;align-items:center}
.draw-toolbar-group.accent{padding:6px;border:1px solid rgba(216,193,124,.14);border-radius:14px;background:rgba(216,193,124,.035)}
.draw-toolbar .btn{min-height:38px}
.draw-toolbar .btn.primary{min-width:146px}
.draw-mode-strip{margin-top:14px;padding:14px 16px;border:1px solid rgba(216,193,124,.14);border-radius:16px;background:linear-gradient(180deg,rgba(17,21,28,.74),rgba(12,16,23,.82));box-shadow:inset 0 1px 0 rgba(255,255,255,.025)}
.draw-mode-kicker{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--faint);font-weight:800}
.draw-mode-line{display:flex;gap:10px;align-items:flex-start;margin-top:8px;flex-wrap:wrap}
.draw-mode-badge{font-weight:700;color:var(--text)}
.draw-mode-badge.good{border-color:rgba(144,183,154,.38);color:#d6eadb}
.draw-mode-badge.warn{border-color:rgba(216,193,124,.36);color:#f0ddb2}
.draw-mode-copy{min-width:0;flex:1;color:#c3ccd6;line-height:1.48;padding-top:2px}
.draw-quick-tips{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.draw-quick-tips span{display:inline-flex;align-items:center;gap:6px;border:1px solid rgba(85,103,126,.28);border-radius:999px;padding:4px 9px;background:rgba(77,93,114,.08);font-size:11px;color:#b8c3cf}
.draw-quick-tips span:before{content:'✦';font-size:10px;color:var(--accent)}
.draw-result-card h3{font-size:11px;color:#d7dde4;letter-spacing:.12em}
.draw-result-card .muted{line-height:1.5}
#drawResult .row:first-child{align-items:flex-start}
@media(max-width:760px){.draw-toolbar{align-items:stretch}.draw-toolbar-group{width:100%}.draw-toolbar-group .btn{flex:1 1 auto}.draw-toolbar .btn.primary{min-width:0}.draw-mode-line{flex-direction:column}}

/* Player archive + lexicon polish */
.player-section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:16px}
.player-section-head h2{font-size:21px;letter-spacing:-.015em}
.player-section-head .muted{max-width:620px;margin-top:4px}
.player-stat-strip{display:flex;gap:8px;flex-wrap:wrap;margin:2px 0 18px}
.player-stat{display:flex;align-items:baseline;gap:7px;border:1px solid rgba(216,193,124,.13);border-radius:999px;padding:6px 10px;background:rgba(216,193,124,.035);color:var(--muted);font-size:10px;letter-spacing:.04em}
.player-stat b{font-size:12px;color:var(--text);letter-spacing:0}
#playerArchive .card:first-child,#playerLexicon .card:first-child{background:linear-gradient(180deg,rgba(27,33,42,.92),rgba(18,23,31,.96));border-color:rgba(216,193,124,.11)}
#playerArchiveList{gap:14px!important}
#playerArchiveList .archive-row{margin-bottom:0;transition:border-color .18s ease,transform .18s ease,box-shadow .18s ease}
#playerArchiveList .archive-row:hover{transform:translateY(-1px);border-color:rgba(216,193,124,.25);box-shadow:0 20px 42px rgba(0,0,0,.2)}
.archive-card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:4px}
.archive-card-title{font-size:16px;font-weight:800;letter-spacing:.01em}
.archive-card-style{font-size:10px;color:var(--muted);margin-top:3px;letter-spacing:.04em}
.archive-reading,.archive-note{margin-top:14px;padding-top:13px;border-top:1px solid rgba(216,193,124,.09)}
.archive-reading h3,.archive-note h3{color:#c8c0a6}
.archive-reading>div{font-size:14px;line-height:1.65;color:#e7e4da}
.archive-note textarea{margin-top:8px;background:rgba(8,12,18,.54);border-color:rgba(216,193,124,.12);min-height:64px}
.archive-empty{padding:52px 20px;text-align:center;color:var(--muted);border:1px dashed rgba(216,193,124,.13);border-radius:16px;background:rgba(10,14,20,.35)}
.lexicon-helper{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:10px;color:var(--muted);font-size:11px}
.lexicon-helper span{display:inline-flex;align-items:center;gap:6px}
.lexicon-helper span:before{content:'✦';font-size:9px;color:rgba(216,193,124,.7)}
.lexicon-layout-tools{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:12px 0 2px;padding:10px 12px;border:1px solid rgba(216,193,124,.11);border-radius:13px;background:rgba(12,16,22,.32)}
.lexicon-layout-tools .row{gap:7px}.lexicon-layout-tools .btn{padding:7px 10px;font-size:11px}.lexicon-layout-status{font-size:11px;color:var(--muted)}
.glyph-cloud.arranging .glyph-bubble{transition:transform .58s cubic-bezier(.22,.9,.24,1),border-color .2s ease,box-shadow .2s ease}
.glyph-bubble.pinned{border-color:rgba(216,193,124,.27);box-shadow:0 16px 42px rgba(0,0,0,.27),0 0 0 1px rgba(216,193,124,.06),inset 0 1px 0 rgba(255,255,255,.09)}
#playerLexicon .player-bubble-stage{margin-top:14px!important}
#playerLexicon .bubble-detail{border-color:rgba(216,193,124,.16);box-shadow:0 18px 45px rgba(0,0,0,.16)}
#playerLexicon .bubble-detail .hero{padding-bottom:12px;border-bottom:1px solid rgba(216,193,124,.08)}
#playerLexicon .bubble-detail .meta{border:1px solid rgba(216,193,124,.07);background:rgba(12,16,22,.58)}
#playerDiscoveries .discovery-stage{background:linear-gradient(180deg,rgba(25,30,38,.9),rgba(15,20,27,.95));border-color:rgba(216,193,124,.11)}
@media(max-width:650px){.player-stat-strip{gap:6px}.player-stat{flex:1 1 auto;justify-content:center}.archive-card-title{font-size:15px}}

@keyframes arcaneBreathe{from{transform:scale(1);opacity:.65}to{transform:scale(1.06);opacity:1}}
@keyframes starDrift{from{background-position:12px 28px,80px 120px}to{background-position:152px 168px,290px 330px}}
@keyframes sparkBlink{0%,100%{opacity:.15;transform:scale(.8)}45%{opacity:.8;transform:scale(1.35)}55%{opacity:.35}}
@keyframes slowTurn{to{transform:rotate(360deg)}}
@keyframes noticePulse{0%,100%{box-shadow:0 0 14px rgba(216,193,124,.05)}50%{box-shadow:0 0 34px rgba(216,193,124,.14),inset 0 0 28px rgba(216,193,124,.06)}}
@keyframes ritualPulse{0%,100%{box-shadow:0 22px 50px rgba(0,0,0,.22),0 0 0 1px rgba(234,214,149,.28),0 0 30px rgba(216,193,124,.2)}50%{box-shadow:0 22px 50px rgba(0,0,0,.22),0 0 0 1px rgba(255,235,174,.52),0 0 56px rgba(234,214,149,.42)}}
@keyframes paperShimmer{0%,100%{opacity:1}50%{opacity:.78}}
@keyframes resultSweep{0%{transform:translateX(-120%)}100%{transform:translateX(120%)}}



/* Player-safe export */
.player-safe-package{display:grid;gap:11px}
.player-safe-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.player-safe-stat{border:1px solid var(--border-soft);border-radius:11px;background:rgba(12,16,22,.56);padding:10px 11px}
.player-safe-stat span{display:block;color:var(--muted);font-size:9px;letter-spacing:.09em;text-transform:uppercase}
.player-safe-stat b{display:block;margin-top:2px;font-size:17px;color:var(--text)}
.player-safe-audit{padding:10px 11px;border:1px solid rgba(144,183,154,.23);border-radius:11px;background:rgba(64,92,70,.08);font-size:11px;color:#bad0c0;line-height:1.45}
.player-safe-audit.warn{border-color:rgba(210,172,111,.34);background:rgba(100,77,35,.10);color:#dfc695}
.player-safe-copy{font-size:11px;color:var(--muted);line-height:1.5}
.live-sync-card{display:grid;gap:10px}.live-sync-status{border:1px solid var(--border-soft);border-radius:11px;padding:10px 11px;background:rgba(12,16,22,.58);font-size:11px;color:var(--muted);line-height:1.45}.live-sync-status.good{border-color:rgba(144,183,154,.28);color:#bfd8c5;background:rgba(64,92,70,.08)}.live-sync-status.warn{border-color:rgba(210,172,111,.34);color:#dfc695;background:rgba(100,77,35,.1)}.live-auth-fields{display:grid;grid-template-columns:1fr 1fr;gap:8px}.live-auth-fields input{font-size:12px}.live-sync-actions{display:flex;gap:7px;flex-wrap:wrap}.live-sync-actions .btn{flex:1 1 120px}.live-invite-output{width:100%;min-height:68px;resize:none;font-size:10px;line-height:1.4;background:#0f141b;border:1px solid var(--border-soft);border-radius:9px;padding:9px;color:#bac4cf}.live-identity{font-size:11px;color:var(--muted);overflow-wrap:anywhere}.live-divider{height:1px;background:var(--border-soft);margin:2px 0}.live-sync-chip{border-color:rgba(216,193,124,.25)!important;color:#d9ca9d!important}
@media(max-width:620px){.player-safe-summary{grid-template-columns:1fr 1fr}.live-auth-fields{grid-template-columns:1fr}}

/* Cleaner language editor */
.compound-editor{padding:18px 20px!important}
.compound-editor .compound-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:12px;border-bottom:1px solid var(--border-soft)}
.compound-editor .compound-title{font-size:16px;font-weight:800;letter-spacing:.025em}
.compound-editor .compound-glyph{display:grid;place-items:center;min-height:170px;padding:16px 0 10px}
.compound-editor .compound-glyph svg{width:132px!important;height:132px!important}
.compound-editor .compound-summary{padding:0 2px 14px;text-align:center}
.compound-editor .compound-summary b{display:block;font-size:14px;line-height:1.45}
.compound-editor .compound-summary .structure{margin-top:5px;color:var(--muted);font-size:12px}
.compound-editor .compound-control{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:14px 2px 2px;border-top:1px solid var(--border-soft)}
.compound-editor .compound-control-copy{min-width:0}
.compound-editor .compound-control-copy b{display:block;font-size:13px}
.compound-editor .compound-control-copy span{display:block;margin-top:2px;color:var(--muted);font-size:11px}
.toggle-switch{position:relative;width:42px;height:24px;flex:0 0 auto}
.toggle-switch input{position:absolute;opacity:0;pointer-events:none}
.toggle-switch i{position:absolute;inset:0;border-radius:999px;background:#202731;border:1px solid #39434e;transition:.18s ease;box-shadow:inset 0 1px 2px rgba(0,0,0,.3)}
.toggle-switch i:after{content:'';position:absolute;width:16px;height:16px;left:3px;top:3px;border-radius:50%;background:#9aa5b0;transition:.18s ease;box-shadow:0 1px 4px rgba(0,0,0,.35)}
.toggle-switch input:checked+i{background:rgba(216,193,124,.22);border-color:#7f7148}
.toggle-switch input:checked+i:after{transform:tran