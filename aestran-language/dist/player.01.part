tart;margin-bottom:10px}.correction-guide-title{font-weight:700;color:var(--text)}.correction-guide-sub{font-size:12px;color:var(--muted);margin-top:3px;line-height:1.4}.correction-guide-body{display:grid;grid-template-columns:minmax(150px,210px) 1fr;gap:14px;align-items:center}.correction-guide svg{width:100%;height:auto;display:block;border-radius:12px;background:rgba(4,7,13,.62)}.correction-legend{display:grid;gap:8px;font-size:12px;color:var(--muted)}.correction-legend-row{display:flex;gap:8px;align-items:center}.guide-swatch{width:24px;height:0;border-top:3px solid rgba(235,245,255,.7);border-radius:999px;flex:none}.guide-swatch.missing{border-color:#f0d88f;box-shadow:0 0 8px rgba(240,216,143,.3)}.guide-swatch.extra{border-color:#7699c8;border-top-style:dashed}.correction-stats{margin-top:4px;font-size:11px;color:var(--muted)}
@keyframes voidPulse{0%,100%{transform:translateY(0);box-shadow:0 24px 55px rgba(0,0,0,.34),0 0 0 1px rgba(244,214,127,.14),0 0 10px rgba(230,186,83,.045),inset 0 0 8px rgba(245,216,126,.016)}50%{transform:translateY(-.5px);box-shadow:0 24px 55px rgba(0,0,0,.34),0 0 0 1px rgba(244,214,127,.22),0 0 26px rgba(230,186,83,.13),inset 0 0 34px rgba(245,216,126,.05)}}
@keyframes goldSweep{0%{opacity:.35;transform:translateX(-35%)}100%{opacity:0;transform:translateX(30%)}}@keyframes resultSweep{0%{transform:translateX(-120%)}100%{transform:translateX(120%)}}
@media(max-width:1000px){#draw .grid2{grid-template-columns:1fr}}@media(max-width:760px){.draw-toolbar{align-items:stretch}.draw-toolbar-group{width:100%}.draw-toolbar-group .btn{flex:1 1 auto}.draw-toolbar .btn.primary{min-width:0}.draw-mode-line{flex-direction:column}}@media(max-width:650px){#drawCanvas{width:100%;height:auto;min-height:0}.draw-stage{min-height:0;padding:12px}.correction-guide-body{grid-template-columns:1fr}.correction-guide svg{max-width:220px;margin:0 auto}}
.updatebox{padding:13px;border:1px solid rgba(216,193,124,.16);border-radius:14px;background:rgba(216,193,124,.035);font-size:11px}.updatebox input{display:none}
/* Live campaign sync */
.live-pill{gap:6px;align-items:center}.live-pill:before{content:'';width:6px;height:6px;border-radius:50%;background:#6d7782;box-shadow:0 0 0 3px rgba(109,119,130,.08)}.live-pill.online:before{background:var(--good);box-shadow:0 0 10px rgba(151,190,160,.45)}.live-pill.warn:before{background:var(--warn);box-shadow:0 0 10px rgba(211,173,112,.35)}
.live-modal{position:fixed;inset:0;z-index:100;display:none;place-items:center;padding:18px;background:rgba(3,6,10,.72);backdrop-filter:blur(14px)}.live-modal.open{display:grid}.live-dialog{width:min(520px,100%);max-height:min(760px,92vh);overflow:auto;border:1px solid rgba(216,193,124,.19);border-radius:20px;padding:20px;background:linear-gradient(180deg,#171e28,#0f151e);box-shadow:0 30px 90px rgba(0,0,0,.5)}.live-dialog-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}.live-dialog-head h2{font-size:18px}.live-close{width:36px;height:36px;padding:0;display:grid;place-items:center}.live-status{margin-top:14px;padding:11px 12px;border:1px solid #2b3541;border-radius:12px;background:#0d131b;color:var(--muted);font-size:11px}.live-status.good{border-color:#395344;color:#c9dfce}.live-status.warn{border-color:#655236;color:#e2c48d}.live-auth{display:grid;gap:9px;margin-top:14px}.live-auth input{width:100%;background:#0d131b;border:1px solid #2c3744;border-radius:10px;padding:10px 11px;outline:none}.live-auth input:focus{border-color:#6a5d3b;box-shadow:0 0 0 3px rgba(216,193,124,.06)}.live-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.live-actions .btn{flex:1 1 auto}.live-identity{margin-top:14px;padding:12px;border:1px solid rgba(216,193,124,.14);border-radius:12px;background:rgba(216,193,124,.035);font-size:12px}.live-divider{height:1px;background:#27313b;margin:16px 0}.live-note{font-size:11px;color:var(--muted);line-height:1.5}.live-toast{position:fixed;z-index:110;right:20px;bottom:20px;width:min(390px,calc(100vw - 28px));padding:15px 16px;border:1px solid rgba(216,193,124,.28);border-radius:15px;background:rgba(17,23,31,.97);box-shadow:0 24px 70px rgba(0,0,0,.42),0 0 28px rgba(216,193,124,.08);transform:translateY(22px);opacity:0;pointer-events:none;transition:.24s ease}.live-toast.show{transform:none;opacity:1;pointer-events:auto}.live-toast b{color:#f0e5c2}.live-toast .row{margin-top:9px}.note-sync{display:inline-block;margin-top:5px;font-size:9px;color:#788592}
@media(max-width:980px){.app{grid-template-columns:1fr}.sidebar{position:sticky;z-index:20;height:auto;padding:12px 15px;border-right:0;border-bottom:1px solid #222a34;overflow:hidden}.brand,.sub{display:none}.nav{display:flex;overflow:auto;margin:0;gap:5px}.nav button{white-space:nowrap}.sidecard{display:none}.main{padding:22px 18px 45px}.grid2{grid-template-columns:1fr}aside .card{border-left:0;border-top:1px solid #222b35;padding:18px 0 0}}
@media(max-width:620px){.topbar{align-items:flex-start}.topbar h1{font-size:21px}.toolbar>div{width:100%}.toolbar .btn{flex:1}.archive-head{display:block}.main{padding-left:12px;padding-right:12px}.layout-tools .btn{flex:1 1 auto;padding-left:9px;padding-right:9px}}
#liveSyncModal{display:none!important}\n</style>
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand">Aestran Decoder</div><div class="sub">Party archive · player build</div>
    <nav class="nav">
      <button class="active" data-screen="archive">Archive</button>
      <button data-screen="discoveries">Discoveries</button>
      <button data-screen="lexicon">Lexicon</button>
      <button data-screen="draw">Draw Glyph</button>
    </nav>
    <div class="sidecard">
      <div class="small">This build contains only the party-safe language snapshot.</div>
      <label class="btn" style="text-align:center">Load update<input id="snapshotFile" type="file" accept="application/json" hidden></label>
      <button class="btn ghost" id="restoreBundled">Restore bundled snapshot</button>
      <div class="small" id="snapshotStatus">Snapshot ready.</div>
    </div>
  </aside>
  <main class="main">
    <header class="topbar"><div><h1 id="pageTitle">Inscription archive</h1><div class="muted" id="pageSub">Recovered inscriptions change as your understanding grows.</div></div><div class="row"><span class="pill good">Player-safe</span><span class="pill live-pill online" id="liveSyncPill">Connecting</span><span class="pill" id="versionPill">v—</span><button class="btn" id="openLiveSync">Sync now</button></div></header>

    <section class="screen active" id="archive">
      <div class="grid2"><div class="card"><div class="row" style="justify-content:space-between;align-items:flex-start"><div><h2>Inscription archive</h2><div class="muted">Your recovered texts and your own interpretations.</div></div><span class="pill" id="archiveCount">0 inscriptions</span></div><div id="archiveList"></div></div><aside><div class="card"><h3>Decoder rules</h3><div class="stack muted" style="margin-top:12px"><div>Only readings present in the player snapshot are used.</div><div>Conventional words appear only after they have been revealed.</div><div>Your interpretation notes are saved only on this device.</div></div></div></aside></div>
    </section>

    <section class="screen" id="discoveries">
      <div class="card"><div class="row" style="justify-content:space-between;align-items:flex-start"><div><h2>Discoveries</h2><div class="muted">Moments when Aestran became a little less unknowable.</div></div><span class="pill" id="discoveryCount">0 discoveries</span></div><div id="timeline" class="timeline"></div></div>
    </section>

    <section class="screen" id="lexicon">
      <div class="grid2"><div class="card"><div class="lexhead"><div><h2>Party lexicon</h2><div class="muted">Known signs drift through the archive. Drag one to place it permanently.</div></div><span class="pill" id="lexCount">0 known</span></div><div class="layout-tools"><button class="btn" id="autoArrange">Auto arrange</button><button class="btn" id="unpinAll">Unpin all</button><button class="btn ghost" id="resetLayout">Reset layout</button></div><div class="bubble-stage" id="bubbleStage"></div></div><aside><div class="card lexdetail" id="lexDetail"><div class="muted">Select a glyph to inspect the party's current understanding.</div></div></aside></div>
    </section>

    <section class="screen" id="draw">
      <div class="grid2">
        <div class="stack">
          <div class="card">
            <div class="row" style="justify-content:space-between;align-items:flex-start;gap:14px"><div><h3>Glyph analysis</h3><div class="muted">Build the rune from straight segments on the 8 × 8 Aestran grid. Each line runs directly from one grid point to another, so diagonals stay clean and intentional.</div></div><span class="pill">Player tool</span></div>
            <div class="draw-stage" id="drawStage" style="margin-top:14px">
              <div class="calligraphy-wrap">
                <div class="ink-hint" style="margin-bottom:10px"><b>Connect the points.</b> Press on one grid point, drag to another, then release. Each drag creates <b>one straight line</b> — horizontal, vertical or diagonal. Build the glyph from as many line segments as you need.</div>
                <canvas id="drawCanvas" width="720" height="720"></canvas>
              </div>
            </div>
            <div class="draw-toolbar">
              <div class="draw-toolbar-group"><button class="btn" id="undoDraw">Undo line</button><button class="btn" id="clearDraw">Clear</button><button class="btn primary" id="recogniseDraw">Analyse drawing</button></div>
              <div class="draw-toolbar-group accent"><button class="btn" id="sampleCrystal">Random</button><button class="btn" id="practiceRune">Practice</button></div>
            </div>
            <div class="draw-mode-strip" id="drawModeStrip">
              <div class="draw-mode-kicker">Current mode</div>
              <div class="draw-mode-line"><span class="pill draw-mode-badge good" id="drawModeBadge">Free draw</span><div class="draw-mode-copy" id="drawModeCopy">Draw any rune the party knows, then press <b>Analyse drawing</b> to see what the inscription means.</div></div>
              <div class="draw-quick-tips"><span>8 × 8 snap grid</span><span>Player-safe hints</span><span>Known-rune practice</span></div>
            </div>
          </div>
          <div class="draw-result-card" id="drawResultCard"><h3>Rune feedback</h3><div id="drawResult" style="margin-top:12px" class="muted">Draw something first.</div></div>
        </div>
        <aside class="stack">
          <div class="card"><h3>How to draw</h3><div class="stack muted" style="margin-top:12px"><div><b style="color:var(--text)">1.</b> Press on a grid point.</div><div><b style="color:var(--text)">2.</b> Drag directly to any other grid point. A straight preview line shows the segment.</div><div><b style="color:var(--text)">3.</b> Release to place that segment. Repeat to build the rune.</div><div>The line never follows the path of your mouse between points, so true diagonals stay diagonal.</div></div></div>
          <div class="card"><h3>Integrated recogniser</h3><div class="stack muted" style="margin-top:12px"><div>1. reads the exact grid lines you placed</div><div>2. breaks long strokes into comparable grid edges</div><div>3. allows the same rune to be shifted around the grid</div><div>4. compares against known roots and known whole-word runes</div><div>5. becomes stricter around visually similar signs</div><div>6. shows a player-safe stroke guide when the shape is incomplete or uncertain</div></div></div>
        </aside>
      </div>
    </section>
  </main>
</div>
<div class="live-modal" id="liveSyncModal" aria-hidden="true">
  <div class="live-dialog" role="dialog" aria-modal="true" aria-labelledby="liveDialogTitle">
    <div class="live-dialog-head"><div><h2 id="liveDialogTitle">Aestra live sync</h2><div class="muted">Connect this Player build to the campaign.</div></div><button class="btn ghost live-close" id="closeLiveSync" aria-label="Close">×</button></div>
    <div class="live-status" id="liveSyncStatus">Checking connection…</div>
    <div id="liveSignedOut">
      <div class="live-auth"><input id="liveEmail" type="email" autocomplete="email" placeholder="Email"><input id="livePassword" type="password" autocomplete="current-password" placeholder="Password"></div>
      <div class="live-actions"><button class="btn primary" id="liveSignIn">Sign in</button><button class="btn" id="liveSignUp">Create account</button></div>
      <div class="live-divider"></div><div class="live-note">Open the invite link your GM gives you, then sign in here. If account creation requires email confirmation, confirm it first and return to the same invite link.</div>
    </div>
    <div id="liveSignedIn" style="display:none">
      <div class="live-identity" id="liveIdentity"></div>
      <div class="liv