slateX(18px);background:var(--accent-strong);box-shadow:0 0 9px rgba(234,214,149,.25)}
.optional-technical{display:none}.app.details-open .optional-technical{display:block}
.compound-tech{margin-top:13px;padding-top:12px;border-top:1px solid var(--border-soft);font-size:11px;color:var(--muted)}
.compound-tech code{display:block;margin-top:5px;white-space:normal;word-break:break-word;color:#9ca8b5;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
.compound-recipe{margin-top:14px;padding:14px;border-top:1px solid var(--border-soft);border-bottom:1px solid var(--border-soft);background:linear-gradient(180deg,rgba(255,255,255,.012),rgba(255,255,255,.02));border-radius:14px}
.compound-recipe .rule-head{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.compound-recipe .rule-blurb{margin-top:8px;color:var(--muted);font-size:12px;line-height:1.55}
.compound-recipe .rule-points{display:grid;gap:8px;margin-top:12px}
.compound-recipe .rule-point{padding:9px 10px;border:1px solid var(--border-soft);border-radius:10px;background:rgba(255,255,255,.018);font-size:12px;line-height:1.45}
.compound-recipe .rule-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:12px}
.compound-recipe .rule-tags .pill{background:#171d25}
.rules-panel{display:grid;gap:10px}
.rules-panel .rule-card{padding:11px 12px;border:1px solid var(--border-soft);border-radius:12px;background:rgba(255,255,255,.018)}
.rules-panel .rule-card b{display:block;font-size:12px}
.rules-panel .rule-card .muted{font-size:11px;line-height:1.5;margin-top:5px}
.rules-panel .rule-card.active{border-color:rgba(216,193,124,.35);box-shadow:0 0 0 1px rgba(216,193,124,.08), inset 0 0 24px rgba(216,193,124,.03)}

@media(max-width:1200px){.audit-grid{grid-template-columns:repeat(5,1fr)}}
@media(max-width:1000px){.app{grid-template-columns:1fr}.sidebar{position:static;height:auto;border-right:0;border-bottom:1px solid var(--border-soft);padding:15px 18px}.brand,.sub{padding-left:0}.nav{grid-template-columns:repeat(3,1fr);margin-top:14px}.nav-group{grid-column:1/-1;margin:10px 0 2px}.side-bottom{display:none}.main{padding:24px}.grid2{grid-template-columns:1fr}.grid2>aside.card,.grid2>aside.stack>.card{border-left:0;border-top:1px solid var(--border-soft);padding:18px 0 0}.app.details-open .optional-rail{display:grid!important}.audit-grid{grid-template-columns:repeat(4,1fr)}}
@media(max-width:650px){.main{padding:18px 14px 44px}.topbar{align-items:flex-start;flex-direction:column}.top-actions{width:100%;justify-content:flex-start}.nav{grid-template-columns:1fr 1fr}.grid3,.two-col,.bubble-detail .meta-grid{grid-template-columns:1fr}.semantic-row{grid-template-columns:1fr}.audit-grid{grid-template-columns:repeat(2,1fr)}.card{padding:16px}.glyph-card{min-width:105px}.grid2{gap:18px}.glyph-cloud{min-height:680px}.glyph-bubble{transform:scale(.95)}}
/* Knowledge + discoveries workflow */
.knowledge-workbench{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:22px;align-items:start}
.knowledge-builder{display:grid;grid-template-columns:150px minmax(150px,1fr) minmax(150px,1fr) auto;gap:10px;align-items:end;margin-top:14px}
.knowledge-queue{display:grid;gap:10px;margin-top:14px}
.queue-empty{padding:22px 14px;text-align:center;border:1px dashed var(--border);border-radius:14px;color:var(--muted);background:rgba(255,255,255,.012)}
.queue-item{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;padding:12px 13px;border:1px solid rgba(216,193,124,.14);border-radius:14px;background:linear-gradient(180deg,rgba(216,193,124,.035),rgba(255,255,255,.012))}
.queue-glyph{width:48px;height:48px;display:grid;place-items:center;border-radius:12px;background:#10151b;border:1px solid var(--border-soft)}
.queue-glyph svg{width:34px!important;height:34px!important}
.queue-copy b{font-size:13px}.queue-copy .muted{font-size:11px;margin-top:3px}
.impact-chip{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 2px;border-bottom:1px solid var(--border-soft)}
.impact-chip:last-child{border-bottom:0}

/* GM discovery release workflow */
.knowledge-release-summary{margin-top:14px;padding:14px 15px;border:1px solid rgba(216,193,124,.16);border-radius:15px;background:linear-gradient(180deg,rgba(216,193,124,.045),rgba(13,17,23,.55))}
.knowledge-release-summary.empty{border-color:var(--border-soft);background:rgba(255,255,255,.012)}
.knowledge-release-title{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}
.knowledge-release-title b{font-size:13px;color:var(--text)}
.knowledge-batch-stats{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.knowledge-batch-stat{display:inline-flex;align-items:baseline;gap:5px;padding:5px 9px;border:1px solid var(--border-soft);border-radius:999px;background:rgba(8,11,16,.36);color:var(--muted);font-size:10px}
.knowledge-batch-stat b{font-size:12px;color:var(--accent-strong)}
.queue-item{grid-template-columns:auto minmax(0,1fr) auto}
.queue-item-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:5px}
.queue-order-controls{display:flex;gap:5px;align-items:center}
.queue-order-controls .btn{padding:6px 8px;min-width:30px}
.queue-order-controls .btn:disabled{opacity:.28;cursor:default}
.knowledge-impact-reading{font-size:11px;line-height:1.45;margin-top:4px}
.knowledge-impact-reading .before{color:var(--muted)}
.knowledge-impact-reading .after{color:#d9e7dd;margin-top:3px}
.knowledge-impact-reading .arrow{color:var(--accent);padding-right:4px}
.knowledge-reveal-sequence{margin-top:13px;padding-top:12px;border-top:1px solid var(--border-soft);font-size:11px;color:var(--muted)}
.knowledge-reveal-sequence b{color:var(--text)}
#pushKnowledge:disabled{opacity:.45;cursor:default;filter:saturate(.45)}
.discovery-stage{position:relative;overflow:hidden;border:1px solid rgba(216,193,124,.14);border-radius:22px;padding:22px;background:radial-gradient(circle at 18% 10%,rgba(216,193,124,.07),transparent 22%),radial-gradient(circle at 82% 70%,rgba(121,151,219,.06),transparent 24%),linear-gradient(180deg,#111722,#0c1119);box-shadow:var(--shadow)}
.discovery-stage:before{content:'';position:absolute;inset:0;pointer-events:none;background-image:radial-gradient(circle,rgba(255,239,181,.28) 0 1px,transparent 1.5px),radial-gradient(circle,rgba(180,206,255,.18) 0 1px,transparent 1.4px);background-size:155px 155px,230px 230px;background-position:18px 24px,90px 126px;opacity:.2;animation:starDrift 32s linear infinite}
.discovery-stage>*{position:relative;z-index:1}
.discovery-header{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:18px}
.discovery-count{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;letter-spacing:.08em;color:var(--accent)}
.discovery-timeline{position:relative;display:grid;gap:14px;padding-left:24px}
.discovery-timeline:before{content:'';position:absolute;left:7px;top:8px;bottom:8px;width:1px;background:linear-gradient(var(--accent),rgba(216,193,124,.08))}
.discovery-card{position:relative;display:grid;grid-template-columns:76px 1fr auto;gap:16px;align-items:center;padding:16px;border:1px solid rgba(216,193,124,.13);border-radius:16px;background:rgba(15,20,28,.76);backdrop-filter:blur(8px);transition:.18s ease}
.discovery-card:hover{border-color:rgba(216,193,124,.32);transform:translateY(-1px);box-shadow:0 12px 30px rgba(0,0,0,.18)}
.discovery-card:before{content:'';position:absolute;left:-22px;top:32px;width:9px;height:9px;border-radius:50%;background:var(--accent);box-shadow:0 0 12px rgba(216,193,124,.55)}
.discovery-symbol{width:72px;height:72px;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(216,193,124,.18);background:radial-gradient(circle at 40% 30%,rgba(255,255,255,.08),rgba(14,19,27,.82));box-shadow:inset 0 0 26px rgba(216,193,124,.035)}
.discovery-symbol svg{width:48px!important;height:48px!important;filter:drop-shadow(0 0 5px rgba(216,193,124,.13))}
.discovery-kind{text-transform:uppercase;letter-spacing:.1em;font-size:9px;color:var(--accent)}
.discovery-title{font-size:15px;font-weight:760;margin-top:3px}.discovery-desc{font-size:12px;color:var(--muted);line-height:1.5;margin-top:5px}
.discovery-echoes{margin-top:8px;display:flex;gap:6px;flex-wrap:wrap}.discovery-echoes .pill{font-size:9px}
.discovery-empty{padding:60px 20px;text-align:center;color:var(--muted)}
.discovery-empty .sigil{font-size:32px;color:rgba(216,193,124,.35);margin-bottom:12px}
@media(max-width:950px){.knowledge-workbench{grid-template-columns:1fr}.knowledge-builder{grid-template-columns:1fr 1fr}.knowledge-builder .btn{width:100%}.discovery-card{grid-template-columns:64px 1fr}.discovery-card>.btn{grid-column:2}}
@media(max-width:650px){.knowledge-builder{grid-template-columns:1fr}.discovery-stage{padding:16px}.discovery-card{grid-template-columns:54px 1fr;padding:13px}.discovery-symbol{width:52px;height:52px}.discovery-symbol svg{width:36px!important;height:36px!important}.discovery-timeline{padding-left:19px}.discovery-card:before{left:-18px}}

/* Player discovery reveal experience */
.discovery-card.newly-revealed{border-color:rgba(234,214,149,.34);box-shadow:0 0 0 1px rgba(234,214,149,.05),0 14px 34px rgba(0,0,0,.2),inset 0 0 30px rgba(216,193,124,.025)}
.discovery-card.newly-revealed:after{content:'NEW';position:absolute;right:14px;top:10px;font-size:8px;font-weight:900;letter-spacing:.16em;color:rgba(244,221,153,.75)}
.discovery-impact-line{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:9px;font-size:10px;color:#aeb8c3}
.discovery-impact-line:before{content:'↺';color:var(--accent);font-size:12px}
.discovery-reveal-overlay{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:24px;background:rgba(5,8,13,.82);backdrop-filter:blur(14px);opacity:0;pointer-events:none;transition:opacity .32s ease;overflow:auto}
.discovery-reveal-overlay.open{opacity:1;pointer-events:auto}
.discovery-reveal-overlay:before{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 50% 38%,rgba(234,214,149,.12),transparent 19%),radial-gradient(circle at 50% 46%,rgba(77,96,153,.11),transparent 35%),radial-gradient(circle,rgba(255,239,181,.35) 0 1px,transparent 1.5px);background-size:auto,auto,145px 145px;animation:discoverySkyDrift 26s linear infinite}
.discovery-reveal-shell{position:relative;width:min(720px,94vw);min-height:520px;display:grid;grid-template-rows:auto 1fr auto;overflow:hidden;border:1px solid rgba(234,214,149,.28);border-radius:28px;background:radial-gradient(circle at 50% 20%,rgba(216,193,124,.07),transparent 24%),linear-gradient(180deg,rgba(18,24,35,.98),rgba(8,12,19,.99));box-shadow:0 35px 100px rgba(0,0,0,.58),0 0 70px rgba(216,193,124,.07),inset 0 1px 0 rgba(255,255,255,.04);transform:translateY(8px) scale(.985);transition:transform .38s cubic-bezier(.2,.8,.2,1)}
.discovery-reveal-overlay.open .discovery-reveal-shell{transform:none}
.discovery-reveal-top{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:18px 22px;border-bottom:1px solid rgba(216,193,124,.1)}
.discovery-reveal-kicker{font-size:9px;font-weight:900;letter-spacing:.2em;text-transform:uppercase;color:var(--accent)}
.discovery-reveal-progress{font:10px/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em;color:var(--faint)}
.discovery-reveal-body{display:grid;justify-items:center;align-content:center;text-align:center;padding:34px clamp(22px,6vw,58px) 26px;position:relative}
.discovery-reveal-rune{position:relative;width:176px;height:176px;display:grid;place-items:center;margin-bottom:24px;border-radius:50%;border:1px solid rgba(234,214,149,.16);background:radial-gradient(circle,rgba(234,214,149,.055),rgba(13,18,28,.22) 55%,transparent 72%)}
.discovery-reveal-rune:before,.discovery-reveal-rune:after{content:'';position:absolute;border-radius:50%;border:1px solid rgba(234,214,149,.12);inset:-18px;animation:discoveryRing 3.1s ease-in-out infinite}
.discovery-reveal-rune:after{inset:-38px;border-color:rgba(122,148,205,.08);animation-delay:-1.55s}
.discovery-reveal-rune svg{width:116px!important;height:116px!important;color:#f5df9e;filter:drop-shadow(0 0 9px rgba(234,214,149,.34)) drop-shadow(0 0 26px rgba(216,193,124,.15))}
.discovery-reveal-overlay.reveal-writing .discovery-reveal-rune svg path{stroke-dasharray:240;stroke-dashoffset:240;animation:discoveryRuneWrite 1.25s cubic-bezier(.3,.7,.2,1) forwards .12s}
.discovery-reveal-title{font-size:25px;font-weight:820;letter-spacing:-.02em;line-height:1.2;max-width:560px}
.discovery-reveal-desc{margin-top:9px;color:#aeb8c4;max-width:560px;line-height:1.6}
.discovery-reveal-impact{width:min(560px,100%);margin-top:22px;display:grid;gap:8px;text-align:left}
.discovery-reveal-impact-head{font-size:9px;text-transform:uppercase;letter-spacing:.15em;color:var(--faint);text-align:center;margin-bottom:2px}
.discovery-echo-card{padding:10px 12px;border:1px solid rgba(216,193,124,.12);border-radius:12px;background:rgba(255,255,255,.018)}
.discovery-echo-title{font-size:11px;font-weight:750;color:#dfe4e9}
.discovery-echo-shift{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center;margin-top:5px;font-size:10px;color:var(--muted)}
.discovery-echo-shift .after{color:#ead89f}.discovery-echo-shift .arrow{color:var(--accent);opacity:.65}
.discovery-reveal-actions{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:18px 22px;border-top:1px solid rgba(216,193,124,.1);background:rgba(5,8,13,.18)}
.discovery-reveal-actions .btn.primary{min-width:150px}
@keyframes discoveryRuneWrite{0%{stroke-dashoffset:240;opacity:.18}70%{opacity:1}100%{stroke-dashoffset:0;opacity:1}}
@keyframes discoveryRing{0%,100%{transform:scale(.96);opacity:.28}50%{transform:scale(1.04);opacity:.7}}
@keyframes discoverySkyDrift{from{background-position:center,center,0 0}to{background-position:center,center,145px 145px}}
@media(max-width:620px){.discovery-reveal-overlay{padding:10px}.discovery-reveal-shell{min-height:500px;border-radius:22px}.discovery-reveal-body{padding:30px 18px 22px}.discovery-reveal-rune{width:142px;height:142px}.discovery-reveal-rune svg{width:94px!important;height:94px!important}.discovery-reveal-title{font-size:21px}.discovery-echo-shift{grid-template-columns:1fr}.discovery-echo-shift .arrow{transform:rotate(90deg);justify-self:center}.discovery-reveal-actions{padding:15px;flex-wrap:wrap}.discovery-reveal-actions .btn{flex:1}}


/* --- SIMPLE BUILDER MODE --- */
.app.simple-gm .top-actions .pill{display:none}
.app.simple-gm .optional-rail,.app.simple-gm .optional-technical{display:none!important}
.app.simple-gm .main{max-width:1180px}
.simple-steps{display:flex;gap:10px;align-items:center;flex-wrap:wrap;color:var(--muted);font-size:12px;margin-bottom:16px}
.simple-steps span{display:inline-flex;align-items:center;gap:7px}.simple-steps b{display:grid;place-items:center;width:22px;height:22px;border-radius:50%;backgrou