se,"svgPath":"M 23 59 L 41 32 L 59 32 L 77 59 M 32 68 L 50 50 L 68 68","writeOrder":[[1,5,3,2],[3,2,5,2],[5,2,7,5],[2,6,4,4],[4,4,6,6]],"writeOrderRule":""},{"id":"ROOT_052","kind":"root","meanings":[],"suspected":[],"discovered":false,"svgPath":"M 23 23 L 77 23 L 77 77 L 32 77 L 32 41 L 59 41 L 59 59 L 50 59","writeOrder":[[1,1,7,1],[7,1,7,7],[7,7,2,7],[2,7,2,3],[2,3,5,3],[5,3,5,5],[5,5,4,5]],"writeOrderRule":""},{"id":"ROOT_053","kind":"root","meanings":[],"suspected":[],"discovered":false,"svgPath":"M 50 23 L 59 41 L 77 41 L 59 59 L 50 77 L 41 59 L 23 41 L 41 41 Z","writeOrder":[[4,1,5,3],[5,3,7,3],[7,3,5,5],[5,5,4,7],[4,7,3,5],[3,5,1,3],[1,3,3,3],[3,3,4,1]],"writeOrderRule":""}],"compounds":[{"id":"WORD_001","kind":"compound","known":false,"tree":{"rel":"inside","a":"ROOT_013","b":"ROOT_017"},"canonicalPath":"M 50 23 L 68 50 L 50 77 L 32 50 Z M 32 50 L 50 59 L 68 50","writeOrder":[[4,1,6,4],[6,4,4,7],[4,7,2,4],[2,4,4,1],[2,4,4,5],[4,5,6,4]],"writeOrderRule":""},{"id":"WORD_002","kind":"compound","known":false,"tree":{"rel":"inside","a":"ROOT_013","b":"ROOT_009"},"canonicalPath":"M 50 14 L 68 32 L 59 77 L 41 77 L 32 32 Z M 41 50 L 59 50","writeOrder":[[4,0,6,2],[6,2,5,7],[5,7,3,7],[3,7,2,2],[2,2,4,0],[3,4,5,4]],"writeOrderRule":""},{"id":"WORD_003","kind":"compound","known":false,"tree":{"rel":"inside","a":"ROOT_023","b":"ROOT_009"},"canonicalPath":"M 32 23 L 68 23 L 68 77 L 32 77 L 23 59 L 23 41 Z M 41 41 L 59 50 L 41 59","writeOrder":[[2,1,6,1],[6,1,6,7],[6,7,2,7],[2,7,1,5],[1,5,1,3],[1,3,2,1],[3,3,5,4],[5,4,3,5]],"writeOrderRule":""},{"id":"WORD_004","kind":"compound","known":false,"tree":{"rel":"inside","a":"ROOT_022","b":"ROOT_017"},"canonicalPath":"M 50 14 L 77 50 L 50 86 L 23 50 Z M 50 32 L 50 68 M 41 50 L 59 50","writeOrder":[[4,0,7,4],[7,4,4,8],[4,8,1,4],[1,4,4,0],[4,2,4,6],[3,4,5,4]],"writeOrderRule":""},{"id":"WORD_005","kind":"compound","known":false,"tree":{"rel":"inside","a":"ROOT_008","b":"ROOT_007"},"canonicalPath":"M 23 32 L 50 23 L 77 32 M 23 68 L 50 77 L 77 68 M 32 41 L 68 59 M 68 41 L 32 59","writeOrder":[[1,2,4,1],[4,1,7,2],[1,6,4,7],[4,7,7,6],[2,3,6,5],[6,3,2,5]],"writeOrderRule":""},{"id":"WORD_006","kind":"compound","known":false,"tree":{"rel":"inside","a":{"rel":"inside","a":"ROOT_013","b":"ROOT_014"},"b":"ROOT_051"},"canonicalPath":"M 59 23 L 32 32 L 23 50 L 32 68 L 59 77 M 50 32 L 68 50 L 50 68","writeOrder":[[5,1,2,2],[2,2,1,4],[1,4,2,6],[2,6,5,7],[4,2,6,4],[6,4,4,6]],"writeOrderRule":""},{"id":"WORD_007","kind":"compound","known":false,"tree":{"rel":"joined","a":"WORD_001","b":"ROOT_033"},"canonicalPath":"M 32 77 L 32 50 L 50 32 L 68 50 L 68 77 M 50 32 L 50 23","writeOrder":[[2,7,2,4],[2,4,4,2],[4,2,6,4],[6,4,6,7],[4,2,4,1]],"writeOrderRule":""},{"id":"WORD_008","kind":"compound","known":false,"tree":{"rel":"below","a":"WORD_001","b":"ROOT_008"},"canonicalPath":"M 23 50 L 77 50 M 50 50 L 41 59 L 50 77 L 59 59 Z","writeOrder":[[1,4,7,4],[4,4,3,5],[3,5,4,7],[4,7,5,5],[5,5,4,4]],"writeOrderRule":""},{"id":"WORD_009","kind":"compound","known":false,"tree":{"rel":"joined","a":"ROOT_024","b":"ROOT_048"},"canonicalPath":"M 23 32 L 50 50 L 77 32 M 23 68 L 50 50 L 77 68 M 50 23 L 50 77","writeOrder":[[1,2,4,4],[4,4,7,2],[1,6,4,4],[4,4,7,6],[4,1,4,7]],"writeOrderRule":""},{"id":"WORD_010","kind":"compound","known":false,"tree":{"rel":"inside","a":"ROOT_014","b":"ROOT_022"},"canonicalPath":"M 23 23 L 41 32 L 59 23 L 77 32 M 32 59 L 50 41 L 68 59 L 50 77 Z","writeOrder":[[1,1,3,2],[3,2,5,1],[5,1,7,2],[2,5,4,3],[4,3,6,5],[6,5,4,7],[4,7,2,5]],"writeOrderRule":""}],"relationships":[{"id":"inside","reading":"A within B","layout":"host/guest","collisionAllowed":false},{"id":"surround","reading":"A surrounds B","layout":"outer/inner","collisionAllowed":false},{"id":"above","reading":"A above B","layout":"vertical bands","collisionAllowed":false},{"id":"below","reading":"A below B","layout":"vertical bands","collisionAllowed":false},{"id":"joined","reading":"A joined to B","layout":"left/right + connector","collisionAllowed":false},{"id":"fused","reading":"A fused with B","layout":"shared strokes","collisionAllowed":true},{"id":"mirrored","reading":"A mirrored with B","layout":"balanced halves","collisionAllowed":false},{"id":"crossed","reading":"A crosses B","layout":"designated crossing","collisionAllowed":true}],"modifiers":["NEGATE","PAST","FUTURE","ONGOING","MANY","INTENSE","WEAKENED","CAUSE","FROM","TOWARD"],"inscriptions":[{"id":"rub-fragment","title":"Rübenberg Fragment","units":["WORD_006","ROOT_005","WORD_005","WORD_007"],"style":"natural","playerNote":"","published":true},{"id":"relic-chamber","title":"Relic Chamber Inscription","units":["ROOT_023","WORD_002"],"style":"natural","playerNote":"","published":true}],"discoveries":[],"knowledgeEpoch":1}</script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.116.0"></script>
<script>
(()=>{
const LIVE_CONFIG={url:'https://pbsfiwzwdseslvnprcph.supabase.co',publishableKey:'sb_publishable_uE7LjZhZf2dXuza1vpGtSQ_CZaR7xFH',campaignId:'00000000-0000-0000-0000-000000000001'};
const BUNDLED=JSON.parse(document.getElementById('bundledSnapshot').textContent);
const STORE='aestra-player-build-v2',NOTE_STORE='aestra-player-notes-v1',LAYOUT_STORE='aestra-player-lexicon-layout-v1';
let SNAP=loadSavedSnapshot()||structuredClone(BUNDLED),notes=readJSON(NOTE_STORE,{})||{},bubbleLayout=readJSON(LAYOUT_STORE,{})||{};
let selectedGlyph=null,bubbleRAF=null,bubbles=[],drag=null;
let liveClient=null,liveSession=null,liveChannel=null,liveJoined=false,pendingInvite=new URLSearchParams(location.search).get('invite')||'',liveAuthSubscription=null,liveToastTimer=null;
const remoteNoteTimers=new Map();
const $=id=>document.getElementById(id),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function readJSON(k,fallback){try{return JSON.parse(localStorage.getItem(k))??fallback}catch{return fallback}}
function loadSavedSnapshot(){const x=readJSON(STORE,null);return validSnapshot(x)&&x.knowledgeEpoch===1?x:null}
function validSnapshot(x){return !!x&&x.kind==='aestra-player-snapshot'&&Array.isArray(x.roots)&&Array.isArray(x.compounds)&&Array.isArray(x.inscriptions)}
function saveSnapshot(){try{localStorage.setItem(STORE,JSON.stringify(SNAP))}catch{}}
function saveNotes(){try{localStorage.setItem(NOTE_STORE,JSON.stringify(notes))}catch{}}
function saveLayout(){try{localStorage.setItem(LAYOUT_STORE,JSON.stringify(bubbleLayout))}catch{}}
function liveStatus(message,tone=''){
  const status=$('liveSyncStatus');if(status){status.textContent=message;status.className='live-status'+(tone?' '+tone:'')}
  const pill=$('liveSyncPill');if(pill){pill.textContent=liveJoined?'Live':'Connecting';pill.className='pill live-pill'+(liveJoined?' online':' warn')}
}
function openLiveModal(){const m=$('liveSyncModal');if(m){m.classList.add('open');m.setAttribute('aria-hidden','false')}}
function closeLiveModal(){const m=$('liveSyncModal');if(m){m.classList.remove('open');m.setAttribute('aria-hidden','true')}}
function renderLiveIdentity(){
  liveStatus(liveJoined?'Connected to Aestra · new releases arrive automatically.':'Connecting to the shared Aestra archive…',liveJoined?'good':'warn');
}
function discoveryKey(x,i=0){return String(x?.id||x?.key||`${x?.label||'discovery'}|${x?.description||''}|${i}`)}
function showLiveToast({discoveries=0,inscriptions=0}={}){
  const toast=$('liveToast');if(!toast)return;
  if(discoveries){$('liveToastTitle').textContent=discoveries===1?'A new Aestran discovery arrived.':`${discoveries} new Aestran discoveries arrived.`;$('liveToastCopy').textContent=inscriptions?`${inscriptions} new inscription${inscriptions===1?'':'s'} also entered the archive.`:'The party lexicon and archived readings have updated.'}
  else{$('liveToastTitle').textContent=inscriptions===1?'A new inscription entered the archive.':`${inscriptions} new inscriptions entered the archive.`;$('liveToastCopy').textContent='The live Aestra archive has updated.'}
  $('liveToastOpen').textContent=discoveries?'View discoveries':'View archive';$('liveToastOpen').dataset.target=discoveries?'discoveries':'archive';toast.classList.add('show');clearTimeout(liveToastTimer);liveToastTimer=setTimeout(()=>toast.classList.remove('show'),9000)
}
function applyRemoteSnapshot(next,{realtime=false}={}){
  if(!validSnapshot(next))return false;
  const beforeDiscoveries=new Set((SNAP.discoveries||[]).map(discoveryKey)),beforeInscriptions=new Set((SNAP.inscriptions||[]).map(x=>String(x.id)));
  const newDiscoveries=(next.discoveries||[]).filter((x,i)=>!beforeDiscoveries.has(discoveryKey(x,i))),newInscriptions=(next.inscriptions||[]).filter(x=>!beforeInscriptions.has(String(x.id)));
  SNAP=next;saveSnapshot();selectedGlyph=null;renderAll();
  if(realtime&&(newDiscoveries.length||newInscriptions.length))showLiveToast({discoveries:newDiscoveries.length,inscriptions:newInscriptions.length});
  return true;
}
async function joinPendingInvite(){
  if(!liveClient||!liveSession||!pendingInvite)return true;
  liveStatus('Joining Aestra with your invite…','warn');
  const {data,error}=await liveClient.rpc('join_aestran_language',{invite_token:pendingInvite});
  if(error){liveJoined=false;liveStatus('Invite could not be used: '+error.message,'warn');return false}
  if(data!==LIVE_CONFIG.campaignId){liveJoined=false;liveStatus('That invite belongs to another campaign.','warn');return false}
  pendingInvite='';try{const u=new URL(location.href);u.searchParams.delete('invite');history.replaceState(null,'',u.href)}catch(_){}
  return true;
}
async function fetchRemoteSnapshot({quiet=false}={}){
  if(!liveClient)return false;
  const {data,error}=await liveClient.from('aestran_language_public').select('published_version,public_state,updated_at').eq('campaign_id',LIVE_CONFIG.campaignId).maybeSingle();
  if(error){liveJoined=false;if(!quiet)liveStatus('Could not reach the Aestra archive. Using the last saved copy on this device.','warn');renderLiveIdentity();return false}
  if(!data||!validSnapshot(data.public_state)){liveJoined=false;if(!quiet)liveStatus('The Aestra archive is not available yet.','warn');renderLiveIdentity();return false}
  liveJoined=true;applyRemoteSnapshot(data.public_state);renderLiveIdentity();
  if(!quiet)$('snapshotStatus').textContent=`Live snapshot loaded · v${SNAP.publishedVersion||data.published_version||'—'}.`;
  return true;
}
async function loadRemoteNotes(){return}
async function saveRemoteNote(inscriptionId,note){return}
function scheduleRemoteNote(inscriptionId,note){return}
function stopLiveChannel(){if(liveClient&&liveChannel)liveClient.removeChannel(liveChannel);liveChannel=null}
function subscribeLiveUpdates(){
  stopLiveChannel();if(!liveClient||!liveJoined)return;
  liveChannel=liveClient.channel('aestran-player-shared-'+LIVE_CONFIG.campaignId).on('postgres_changes',{event:'*',schema:'public',table:'aestran_language_public',filter:'campaign_id=eq.'+LIVE_CONFIG.campaignId},payload=>{
    const next=payload.new?.public_state;
    if(validSnapshot(next)){applyRemoteSnapshot(next,{realtime:true});liveStatus('Aestra updated just now.','good')}
  }).subscribe(status=>{
    if(status==='SUBSCRIBED')liveStatus('Connected to Aestra · new releases arrive automatically.','good');
    else if(status==='CHANNEL_ERROR'||status==='TIMED_OUT')liveStatus('Live updates paused. Tap Sync now to retry.','warn')
  })
}
async function connectLiveCampaign(){
  const ok=await fetchRemoteSnapshot();
  if(ok)subscribeLiveUpdates();
  renderLiveIdentity();
  return ok;
}
async function handleLiveSession(session){
  liveSession=session||null;liveJoined=false;stopLiveChannel();renderLiveIdentity();if(liveSession)await connectLiveCampaign();
}
async function liveSignIn(){
  if(!liveClient)return;const email=$('liveEmail').value.trim(),password=$('livePassword').value;if(!email||!password){liveStatus('Enter your email and password.','warn');return}liveStatus('Signing in…');const {error}=await liveClient.auth.signInWithPassword({email,password});if(error)liveStatus('Sign-in failed: '+error.message,'warn')
}
async function liveSignUp(){
  if(!liveClient)return;const email=$('liveEmail').value.trim(),password=$('livePassword').value;if(!email||password.length<6){liveStatus('Enter an email and a password of at least 6 characters.','warn');return}liveStatus('Creating account…');const {data,error}=await liveClient.auth.signUp({email,password});if(error)liveStatus('Account creation failed: '+error.message,'warn');else if(!data.session)liveStatus('Account created. Confirm the email if Supabase asks you to, then return to this invite link and sign in.','good')
}
async function initLiveSync(){
  $('liveToastDismiss').onclick=()=>$('liveToast').classList.remove('show');
  $('liveToastOpen').onclick=()=>{$('liveToast').classList.remove('show');showScreen($('liveToastOpen').dataset.target||'discoveries')};
  $('openLiveSync').onclick=async()=>{
    liveStatus