Array(x.inscriptions)}
function saveSnapshot(){try{localStorage.setItem(STORE,JSON.stringify(SNAP))}catch{}}
function saveNotes(){try{localStorage.setItem(NOTE_STORE,JSON.stringify(notes))}catch{}}
function saveLayout(){try{localStorage.setItem(LAYOUT_STORE,JSON.stringify(bubbleLayout))}catch{}}
function liveStatus(message,tone=''){
  const status=$('liveSyncStatus');if(status){status.textContent=message;status.className='live-status'+(tone?' '+tone:'')}
  const pill=$('liveSyncPill');if(pill){pill.textContent=liveSession?(liveJoined?'Live':'Signed in'):'Offline';pill.className='pill live-pill'+(liveJoined?' online':liveSession?' warn':'')}
}
function openLiveModal(){const m=$('liveSyncModal');if(m){m.classList.add('open');m.setAttribute('aria-hidden','false')}}
function closeLiveModal(){const m=$('liveSyncModal');if(m){m.classList.remove('open');m.setAttribute('aria-hidden','true')}}
function renderLiveIdentity(){
  const signed=!!liveSession;$('liveSignedOut').style.display=signed?'none':'block';$('liveSignedIn').style.display=signed?'block':'none';
  if(signed)$('liveIdentity').innerHTML=`<b>${esc(liveSession.user.email||'Signed-in player')}</b><div class="muted" style="margin-top:3px">${liveJoined?'Joined to Aestra · automatic updates active':'Signed in · not joined to Aestra yet'}</div>`;
  liveStatus(signed?(liveJoined?'Connected to Aestra. New releases will arrive automatically.':pendingInvite?'Invite ready. Joining Aestra…':'Signed in, but this account has not joined Aestra.'):'Offline. Manual snapshot loading still works.',signed?(liveJoined?'good':'warn'):'');
}
function discoveryKey(x,i=0){return String(x?.id||x?.key||`${x?.label||'discovery'}|${x?.description||''}|${i}`)}
function showLiveToast({discoveries=0,inscriptions=0}={}){
  const toast=$('liveToast');if(!toast)return;
  if(discoveries){$('liveToastTitle').textContent=discoveries===1?'A new Aestran discovery arrived.':`${discoveries} new Aestran discoveries arrived.`;$('liveToastCopy').textContent=inscriptions?`${inscriptions} new inscription${inscriptions===1?'':'s'} also entered the archive.`:'The party lexicon and archived readings have updated.'}
  else{$('liveToastTitle').textContent=inscriptions===1?'A new inscription entered the archive.':`${inscriptions} new inscriptions entered the archive.`;$('liveToastCopy').textContent='The live Aestra archive has updated.'}
  $('liveToastOpen').textContent=discoveries?'View discoveries':'View archive';$('liveToastOpen').dataset.target=discoveries?'discoveries':'archive';toast.classList.add('show');clearTimeout(liveToastTimer);liveToastTimer=setTimeout(()=>toast.classList.remove('show'),9000)
}
function applyRemoteSnapshot(next,{realtime=false}={}){
  if(!validSnapshot(next))return false;
  const beforeDiscoveries=new Set((SNAP.discoveries||[]).map(discoveryKey)),beforeInscriptions=new Set((SNAP.inscriptions||[]).map(x=>String(x.id)));
  const newDiscoveries=(next.discoveries||[]).filter((x,i)=>!beforeDiscoveries.has(discoveryKey(x,i))),newInscriptions=(next.inscriptions||[]).filter(x=>!beforeInscriptions.has(String(x.id)));
  SNAP=next;saveSnapshot();selectedGlyph=null;renderAll();
  if(realtime&&(newDiscoveries.length||newInscriptions.length))showLiveToast({discoveries:newDiscoveries.length,inscriptions:newInscriptions.length});
  return true;
}
async function joinPendingInvite(){
  if(!liveClient||!liveSession||!pendingInvite)return true;
  liveStatus('Joining Aestra with your invite…','warn');
  const {data,error}=await liveClient.rpc('join_aestran_language',{invite_token:pendingInvite});
  if(error){liveJoined=false;liveStatus('Invite could not be used: '+error.message,'warn');return false}
  if(data!==LIVE_CONFIG.campaignId){liveJoined=false;liveStatus('That invite belongs to another campaign.','warn');return false}
  pendingInvite='';try{const u=new URL(location.href);u.searchParams.delete('invite');history.replaceState(null,'',u.href)}catch(_){}
  return true;
}
async function fetchRemoteSnapshot({quiet=false}={}){
  if(!liveClient||!liveSession)return false;
  const {data,error}=await liveClient.from('aestran_language_public').select('published_version,public_state,updated_at').eq('campaign_id',LIVE_CONFIG.campaignId).maybeSingle();
  if(error){liveJoined=false;if(!quiet)liveStatus('Could not read the Aestra player snapshot: '+error.message,'warn');renderLiveIdentity();return false}
  if(!data||!validSnapshot(data.public_state)){liveJoined=false;if(!quiet)liveStatus('Signed in, but this account has not joined Aestra. Open the GM invite link with this account.','warn');renderLiveIdentity();return false}
  liveJoined=true;applyRemoteSnapshot(data.public_state);renderLiveIdentity();if(!quiet)$('snapshotStatus').textContent=`Live snapshot loaded · v${SNAP.publishedVersion||data.published_version||'—'}.`;return true;
}
async function loadRemoteNotes(){
  if(!liveClient||!liveSession||!liveJoined)return;
  const {data,error}=await liveClient.from('aestran_language_notes').select('inscription_id,note,updated_at').eq('campaign_id',LIVE_CONFIG.campaignId).eq('user_id',liveSession.user.id);
  if(error){liveStatus('Snapshot is live, but private notes could not sync: '+error.message,'warn');return}
  (data||[]).forEach(r=>{notes[r.inscription_id]=r.note});saveNotes();renderArchive();
}
async function saveRemoteNote(inscriptionId,note){
  if(!liveClient||!liveSession||!liveJoined)return;
  const row={campaign_id:LIVE_CONFIG.campaignId,user_id:liveSession.user.id,inscription_id:inscriptionId,note,updated_at:new Date().toISOString()};
  const {error}=await liveClient.from('aestran_language_notes').upsert(row,{onConflict:'campaign_id,user_id,inscription_id'});
  const marker=document.querySelector(`[data-note-sync="${CSS.escape(inscriptionId)}"]`);if(marker)marker.textContent=error?'Saved locally · cloud retry later':'Saved privately';
  if(error)liveStatus('Your note is safe locally, but cloud note sync failed: '+error.message,'warn');
}
function scheduleRemoteNote(inscriptionId,note){
  clearTimeout(remoteNoteTimers.get(inscriptionId));if(!liveJoined)return;const timer=setTimeout(()=>{remoteNoteTimers.delete(inscriptionId);saveRemoteNote(inscriptionId,note)},650);remoteNoteTimers.set(inscriptionId,timer)
}
function stopLiveChannel(){if(liveClient&&liveChannel)liveClient.removeChannel(liveChannel);liveChannel=null}
function subscribeLiveUpdates(){
  stopLiveChannel();if(!liveClient||!liveSession||!liveJoined)return;
  liveChannel=liveClient.channel('aestran-player-'+LIVE_CONFIG.campaignId).on('postgres_changes',{event:'*',schema:'public',table:'aestran_language_public',filter:'campaign_id=eq.'+LIVE_CONFIG.campaignId},payload=>{
    const next=payload.new?.public_state;if(validSnapshot(next)){applyRemoteSnapshot(next,{realtime:true});liveStatus('Aestra updated just now.','good')}
  }).subscribe(status=>{if(status==='SUBSCRIBED')liveStatus('Connected to Aestra · listening for new releases.','good');else if(status==='CHANNEL_ERROR'||status==='TIMED_OUT')liveStatus('Live updates paused. Use Sync now to retry.','warn')})
}
async function connectLiveCampaign(){
  if(!liveSession)return false;if(pendingInvite){const ok=await joinPendingInvite();if(!ok){renderLiveIdentity();return false}}
  const ok=await fetchRemoteSnapshot();if(ok){await loadRemoteNotes();subscribeLiveUpdates()}renderLiveIdentity();return ok
}
async function handleLiveSession(session){
  liveSession=session||null;liveJoined=false;stopLiveChannel();renderLiveIdentity();if(liveSession)await connectLiveCampaign();
}
async function liveSignIn(){
  if(!liveClient)return;const email=$('liveEmail').value.trim(),password=$('livePassword').value;if(!email||!password){liveStatus('Enter your email and password.','warn');return}liveStatus('Signing in…');const {error}=await liveClient.auth.signInWithPassword({email,password});if(error)liveStatus('Sign-in failed: '+error.message,'warn')
}
async function liveSignUp(){
  if(!liveClient)return;const email=$('liveEmail').value.trim(),password=$('livePassword').value;if(!email||password.length<6){liveStatus('Enter an email and a password of at least 6 characters.','warn');return}liveStatus('Creating account…');const {data,error}=await liveClient.auth.signUp({email,password});if(error)liveStatus('Account creation failed: '+error.message,'warn');else if(!data.session)liveStatus('Account created. Confirm the email if Supabase asks you to, then return to this invite link and sign in.','good')
}
async function initLiveSync(){
  $('openLiveSync').onclick=openLiveModal;$('closeLiveSync').onclick=closeLiveModal;$('liveSyncModal').onclick=e=>{if(e.target===$('liveSyncModal'))closeLiveModal()};document.addEventListener('keydown',e=>{if(e.key==='Escape')closeLiveModal()});$('liveToastDismiss').onclick=()=>$('liveToast').classList.remove('show');$('liveToastOpen').onclick=()=>{$('liveToast').classList.remove('show');showScreen($('liveToastOpen').dataset.target||'discoveries')};
  if(!window.supabase?.createClient){liveStatus('Live sync library could not load. Manual snapshot loading remains available.','warn');return}
  liveClient=window.supabase.createClient(LIVE_CONFIG.url,LIVE_CONFIG.publishableKey,{auth:{persistSession:true,autoRefreshToken:true,detectSessionInUrl:true}});
  $('liveSignIn').onclick=liveSignIn;$('liveSignUp').onclick=liveSignUp;$('liveSignOut').onclick=()=>liveClient.auth.signOut();$('liveRefresh').onclick=async()=>{liveStatus('Refreshing Aestra…');const ok=await connectLiveCampaign();if(ok)$('snapshotStatus').textContent=`Live sync refreshed · v${SNAP.publishedVersion||'—'}.`};
  const {data:{session}}=await liveClient.auth.getSession();await handleLiveSession(session);
  const sub=liveClient.auth.onAuthStateChange((_event,session)=>setTimeout(()=>handleLiveSession(session),0));liveAuthSubscription=sub.data?.subscription||null;
  if(pendingInvite)openLiveModal();
}
const rootMap=()=>Object.fromEntries(SNAP.roots.map(x=>[x.id,x])),compoundMap=()=>Object.fromEntries(SNAP.compounds.map(x=>[x.id,x]));
function knownRoots(){return SNAP.roots.filter(r=>r.discovered!==false&&((r.meanings||[]).length||(r.suspected||[]).length))}
function knownCompounds(){return SNAP.compounds.filter(c=>c.known)}
function runePath(id){return rootMap()[id]?.svgPath||compoundMap()[id]?.canonicalPath||''}
function runeSVG(id,size=72){const p=runePath(id);return `<svg viewBox="0 0 100 100" style="width:${size}px;height:${size}px" aria-label="${esc(id)} glyph"><path d="${esc(p)}"/></svg>`}
function rootReading(id){const r=rootMap()[id];if(!r)return '???';if((r.meanings||[]).length)return r.meanings[0];if((r.suspected||[]).length)return r.suspected[0]+' ?';return '???'}
const REL={inside:'inside',surrounding:'around',above:'above',below:'below',joined:'joined',fused:'fused with',crossed:'crossing',mirrored:'mirrored with',repeated:'repeated with'};
function treeReading(node){if(typeof node==='string'){const c=compoundMap()[node];if(c?.known)return node.toLowerCase();const r=rootMap()[node];if(r)return rootReading(node);if(c)return treeReading(c.tree);return '???'}if(!node||typeof node!=='object'||!node.rel)return '???';return `${treeReading(node.a)} ${REL[node.rel]||node.rel} ${treeReading(node.b)}`}
function conceptReading(id){const r=rootMap()[id];if(r)return rootReading(id);const c=compoundMap()[id];if(!c)return '???';return c.known?id.toLowerCase():treeReading(c.tree)}
function renderUnits(units){return `<div class="glyphline">${(units||[]).map(id=>`<div class="glyphcard">${runeSVG(id,72)}</div>`).join('')}</div>`}
function showScreen(id){
  const meta={archive:['Inscription archive','Recovered inscriptions change as your understanding grows.'],discoveries:['Discoveries','The language remembers each moment of understanding.'],lexicon:['Party lexicon','Every sign the party can currently recognise.'],draw:['Glyph analysis','Draw, analyse and practise known Aestran signs.']}[id];
  if(!meta)return;
  if(id!=='draw'&&typeof cancelGoldRetrace==='function'){
    clearPracticeTimer();
    if(randomReferenceActive){randomReferenceActive=false;randomReferenceTarget=null;resetDrawingState();setDrawMode('Free draw',freeDrawModeCopy(),'good');$('drawResult').innerHTML='Draw something first.';$('drawResultCard').classList.remove('answered')}
    else if(practicePhase==='demo'){practicePhase='idle';practiceTarget=null;setPracticeDemoControls(false);resetDrawingState();setDrawMode('Free draw',freeDrawModeCopy(),'good');$('drawResult').innerHTML='Draw something first.';$('drawResultCard').classList.remove('answered')}
    else if(analysisInProgress){analysisInProgress=false;cancelGoldRetrace();if(practicePhase==='draw'&&practiceTarget)setDrawMode('Practice · Your turn','Keep refining <b>'+esc(practiceTarget.id)+'</b>, then analyse again when you are ready.','good');else setDrawMode('Free draw',freeDrawModeCopy(),'good')}
    else cancelGoldRetrace();
  }
  document.querySelectorAll('.screen').forEach(x=>x.classList.toggle('active',x.id===id));document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('active',x.dataset.screen===id));$('pageTitle').textContent=meta[0];$('pageSub').textContent=meta[1];if(id==='lexicon')startBubbles();else stopBubbles();window.scrollTo({top:0,behavior:'smooth'})
}
document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>showScreen(b.dataset.screen));
function renderArchive(){const list=$('archiveList'),items=SNAP.inscriptions||[];$('archiveCount').textContent=`${items.length} inscription${items.length===1?'':'s'}`;list.innerHTML=items.length?items.map(i=>`<article class="archive-item"><div class="archive-head"><div><div class="archive-title">${esc(i.title||'Recovered inscription')}</div><div class="muted" style="font-size:11px">${esc(i.style||'natural')}</div></div><span class="pill">${(i.units||[]).length} signs</span></div>${renderUnits(i.units)}<div class="reading"><h3>Decoder reading</h3><div style="margin-top:5px">${(i.units||[]).map(x=>`<span class="${conceptReading(x)==='???'?'unknown':''}">${esc(conceptReading(x))}</span>`).join(' · ')}</div></div><div class="note"><h3>Your interpretation</h3><textarea rows="2" data-note="${esc(i.id)}" placeholder="Write your interpretation…">${esc(notes[i.id]??i.playerNote??'')}</textarea><span class="note-sync" data-note-sync="${esc(i.id)}">${liveJoined?'Private sync ready':'Saved locally'}</span></div></article>`).join(''):`<div class="empty" style="margin-top:16px">No inscriptions have been released to the party yet.</div>`;list.querySelectorAll('[data-note]').forEach(t=>t.oninput=()=>{notes[t.dataset.note]=t.value;saveNotes();const marker=document.querySelector(`[data-note-sync="${CSS.escape(t.dataset.note)}"]`);if(marker)marker.textContent=liveJoined?'Saving privately…':'Saved locally';scheduleRemoteNote(t.dataset.note,t.value)})}
function renderDiscoveries(){const d=[...(SNAP.discoveries||[])].reverse();$('discoveryCount').textContent=`${d.length} discover${d.length===1?'y':'ies'}`;$('timeline').innerHTML=d.length?d.map(x=>`<div class="discovery"