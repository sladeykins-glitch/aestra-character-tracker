l appear here.</div>';return}selectedGlyph=id;const r=rootMap()[id],c=compoundMap()[id];let meanings=[];if(r){meanings=[...(r.meanings||[]).map(x=>[x,false]),...(r.suspected||[]).map(x=>[x,true])]}else if(c?.known)meanings=[[id.toLowerCase(),false]];$('lexDetail').innerHTML=`<div class="lexhero">${runeSVG(id,115)}</div><div style="text-align:center"><b>${esc(id)}</b><div class="muted" style="font-size:11px">${r?'Root sign':'Established word'}</div></div><div class="meanings" style="margin-top:14px">${meanings.map(([m,s])=>`<span class="meaning ${s?'sus':''}">${esc(m)}${s?' ?':''}</span>`).join('')}</div>${c?`<div class="muted" style="margin-top:14px;font-size:11px">Recognised as a conventional whole-word rune.</div>`:''}`}
$('autoArrange').onclick=()=>{const stage=$('bubbleStage'),r=stage.getBoundingClientRect(),metrics=lexiconBubbleMetrics(bubbles.length,r.width);stage.style.height=metrics.height+'px';stage.dataset.density=metrics.density;const h=metrics.height,w=Math.max(1,r.width);bubbles.forEach((b,i)=>{applyBubbleSizing(b,metrics);const pos=defaultBubblePosition(i,bubbles.length,metrics,w,h);b.x=pos.x;b.y=pos.y;b.pinned=true;b.el.classList.add('pinned');bubbleLayout[b.id]={x:b.x,y:b.y,pinned:true};positionBubble(b)});saveLayout()};
$('unpinAll').onclick=()=>{bubbles.forEach(b=>{b.pinned=false;b.el.classList.remove('pinned');bubbleLayout[b.id]={x:b.x,y:b.y,pinned:false}});saveLayout()};
$('resetLayout').onclick=()=>{bubbleLayout={};saveLayout();renderLexicon()};
let lexiconResizeTimer=null;window.addEventListener('resize',()=>{if(!$('lexicon').classList.contains('active'))return;clearTimeout(lexiconResizeTimer);lexiconResizeTimer=setTimeout(refreshLexiconSizing,120)});
// Mobile lexicon density pass: adaptive visual bubbles with stable touch targets.
// Drawing / recognition — player build parity with the GM Player view.
const canvas=$('drawCanvas'),ctx=canvas.getContext('2d'),drawStage=$('drawStage');
const inkCanvas=document.createElement('canvas'),inkCtx=inkCanvas.getContext('2d');inkCanvas.width=canvas.width;inkCanvas.height=canvas.height;
const DRAW_GRID={cells:8,margin:60};
let drawStrokes=[],drawHoverPoint=null,drawDragStart=null,drawPreviewPoint=null,drawPointerId=null,drawTraceAnimation=null,drawFadeAnimation=null,drawSparks=[],practiceTarget=null,practicePhase='idle',practiceTimer=null,lastRandomRuneId=null,randomReferenceTarget=null,randomReferenceActive=false,analysisInProgress=false;
let lastAmbientFrame=0;
const cosmicStars=Array.from({length:82},()=>({x:Math.random()*canvas.width,y:Math.random()*canvas.height,r:Math.random()*1.55+.3,drift:(Math.random()-.5)*.075,fall:(Math.random()-.5)*.04,phase:Math.random()*Math.PI*2,alpha:.25+Math.random()*.5,warm:Math.random()>.84}));
function drawGridMetrics(){const size=Math.min(canvas.width,canvas.height)-DRAW_GRID.margin*2,step=size/DRAW_GRID.cells;return{x0:(canvas.width-size)/2,y0:(canvas.height-size)/2,size,step}}
function snapDrawPoint(p){const g=drawGridMetrics(),gx=Math.max(0,Math.min(8,Math.round((p.x-g.x0)/g.step))),gy=Math.max(0,Math.min(8,Math.round((p.y-g.y0)/g.step)));return{x:g.x0+gx*g.step,y:g.y0+gy*g.step,gx,gy,t:p.t}}
function canvasPos(e){const r=canvas.getBoundingClientRect();return snapDrawPoint({x:(e.clientX-r.left)*canvas.width/r.width,y:(e.clientY-r.top)*canvas.height/r.height,t:performance.now()})}
function drawBackground(now){ctx.clearRect(0,0,canvas.width,canvas.height);const g=ctx.createLinearGradient(0,0,0,canvas.height);g.addColorStop(0,'#05070d');g.addColorStop(.55,'#09101f');g.addColorStop(1,'#04060b');ctx.fillStyle=g;ctx.fillRect(0,0,canvas.width,canvas.height);const haze=ctx.createRadialGradient(canvas.width*.52,canvas.height*.42,10,canvas.width*.52,canvas.height*.42,canvas.width*.45);haze.addColorStop(0,'rgba(31,37,66,.2)');haze.addColorStop(.5,'rgba(20,24,41,.07)');haze.addColorStop(1,'rgba(0,0,0,0)');ctx.fillStyle=haze;ctx.fillRect(0,0,canvas.width,canvas.height);const dg=drawGridMetrics();ctx.save();ctx.lineWidth=1;for(let i=0;i<=8;i++){const x=dg.x0+i*dg.step,y=dg.y0+i*dg.step;ctx.strokeStyle=i===4?'rgba(216,193,124,.20)':'rgba(147,173,215,.105)';ctx.beginPath();ctx.moveTo(x,dg.y0);ctx.lineTo(x,dg.y0+dg.size);ctx.stroke();ctx.beginPath();ctx.moveTo(dg.x0,y);ctx.lineTo(dg.x0+dg.size,y);ctx.stroke()}ctx.strokeStyle='rgba(216,193,124,.24)';ctx.lineWidth=1.2;ctx.strokeRect(dg.x0,dg.y0,dg.size,dg.size);for(let gy=0;gy<=8;gy++)for(let gx=0;gx<=8;gx++){const x=dg.x0+gx*dg.step,y=dg.y0+gy*dg.step,centre=gx===4||gy===4;ctx.beginPath();ctx.fillStyle=centre?'rgba(240,216,143,.62)':'rgba(195,215,242,.43)';ctx.arc(x,y,centre?2.35:1.8,0,Math.PI*2);ctx.fill()}ctx.restore();cosmicStars.forEach((s,i)=>{const x=(s.x+now*.005*s.drift*60+canvas.width)%canvas.width,y=(s.y+now*.005*s.fall*60+canvas.height)%canvas.height,tw=(Math.sin(now*.0019+s.phase)+1)/2,a=s.alpha*(.45+.75*tw);ctx.beginPath();ctx.fillStyle=s.warm?`rgba(248,221,144,${a})`:`rgba(214,225,255,${a*.9})`;ctx.arc(x,y,s.r,0,Math.PI*2);ctx.fill();if(i%14===0){ctx.strokeStyle=`rgba(255,239,180,${a*.18})`;ctx.lineWidth=.7;ctx.beginPath();ctx.moveTo(x-s.r*1.8,y);ctx.lineTo(x+s.r*1.8,y);ctx.moveTo(x,y-s.r*1.8);ctx.lineTo(x,y+s.r*1.8);ctx.stroke()}})}
function stampBrushDot(target,x,y,r,color,blur){target.save();target.shadowColor=color;target.shadowBlur=blur;target.fillStyle=color;target.beginPath();target.arc(x,y,Math.max(.8,r),0,Math.PI*2);target.fill();target.restore()}
function stampBrushSegment(target,a,b,layers,stepSize=1.6){const dx=b.x-a.x,dy=b.y-a.y,dist=Math.hypot(dx,dy)||1,steps=Math.max(1,Math.ceil(dist/stepSize));for(let s=0;s<=steps;s++){const t=s/steps,x=a.x+dx*t,y=a.y+dy*t,w=(a.w||7.2)+((b.w||7.2)-(a.w||7.2))*t;layers.forEach(l=>stampBrushDot(target,x,y,w*.5+l.extra,l.color,l.blur))}}
function paintNormalDab(p){[{extra:1.25,color:'rgba(86,130,214,.14)',blur:15},{extra:.55,color:'rgba(176,219,255,.52)',blur:6.5},{extra:0,color:'rgba(235,245,255,.95)',blur:2.1}].forEach(l=>stampBrushDot(inkCtx,p.x,p.y,(p.w||7.2)*.5+l.extra,l.color,l.blur))}
function paintNormalSegment(a,b){stampBrushSegment(inkCtx,a,b,[{extra:1.25,color:'rgba(86,130,214,.13)',blur:14},{extra:.55,color:'rgba(176,219,255,.54)',blur:6.5},{extra:0,color:'rgba(235,245,255,.96)',blur:2.2}],1.55)}
function rebuildInkLayer(){inkCtx.clearRect(0,0,inkCanvas.width,inkCanvas.height);drawStrokes.forEach(st=>{if(st.length<2)return;paintNormalDab(st[0]);paintNormalSegment(st[0],st[1]);paintNormalDab(st[1])})}
function renderInkLayer(alpha=1){ctx.save();ctx.globalAlpha=Math.max(0,Math.min(1,alpha));ctx.drawImage(inkCanvas,0,0);ctx.restore()}
function drawingSegments(){return drawStrokes.filter(s=>s.length>1).map((s,i)=>({a:s[0],b:s[1],length:Math.hypot(s[1].x-s[0].x,s[1].y-s[0].y)||1,strokeIndex:i}))}
function drawGoldLine(a,b,progress=1,alpha=1){progress=Math.max(0,Math.min(1,progress));if(progress<=0)return;const x=a.x+(b.x-a.x)*progress,y=a.y+(b.y-a.y)*progress,passes=[{w:18,c:[196,133,31],a0:.025,a1:.07,a2:.12,blur:20},{w:11,c:[238,183,65],a0:.08,a1:.22,a2:.34,blur:14},{w:6.5,c:[255,225,128],a0:.18,a1:.52,a2:.9,blur:9},{w:3.2,c:[255,248,207],a0:.28,a1:.72,a2:1,blur:3}];ctx.save();ctx.lineCap='round';ctx.lineJoin='round';for(const p of passes){const [r,g,bv]=p.c,grad=ctx.createLinearGradient(a.x,a.y,x,y);grad.addColorStop(0,`rgba(${r},${g},${bv},${p.a0*alpha})`);grad.addColorStop(.72,`rgba(${r},${g},${bv},${p.a1*alpha})`);grad.addColorStop(1,`rgba(${r},${g},${bv},${p.a2*alpha})`);ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(x,y);ctx.lineWidth=p.w;ctx.strokeStyle=grad;ctx.shadowColor=`rgba(${r},${g},${bv},${Math.max(p.a1,p.a2*.75)*alpha})`;ctx.shadowBlur=p.blur;ctx.stroke()}for(const h of [{r:4.8,c:`rgba(214,147,33,${.10*alpha})`,blur:18},{r:2.7,c:`rgba(255,208,96,${.24*alpha})`,blur:10},{r:1.35,c:`rgba(255,246,204,${.96*alpha})`,blur:4}]){ctx.beginPath();ctx.fillStyle=h.c;ctx.shadowColor=h.c;ctx.shadowBlur=h.blur;ctx.arc(x,y,h.r,0,Math.PI*2);ctx.fill()}ctx.restore()}
function renderTraceTipSparks(x,y,ux,uy,now){const nx=-uy,ny=ux;ctx.save();for(let i=0;i<5;i++){const phase=now*.0048+i*1.73,age=((now*.0011+i*.193)%1),back=4+age*22,side=Math.sin(phase)*7*(.45+age*.55),px=x-ux*back+nx*side,py=y-uy*back+ny*side-age*4,alpha=(1-age)*(.38+(i%2)*.12),r=.9+(1-age)*1.15;ctx.beginPath();ctx.fillStyle=`rgba(255,229,143,${alpha})`;ctx.shadowColor='rgba(255,211,92,.8)';ctx.shadowBlur=7;ctx.arc(px,py,r,0,Math.PI*2);ctx.fill()}ctx.restore()}
function drawTraceLeadingEdge(a,b,p,now){p=Math.max(0,Math.min(1,p));if(!p)return;const x=a.x+(b.x-a.x)*p,y=a.y+(b.y-a.y)*p,dx=x-a.x,dy=y-a.y,len=Math.hypot(dx,dy)||1,ux=dx/len,uy=dy/len,tail=Math.min(34,Math.max(12,len*.36)),sx=x-ux*tail,sy=y-uy*tail;ctx.save();ctx.lineCap='round';const grad=ctx.createLinearGradient(sx,sy,x,y);grad.addColorStop(0,'rgba(255,226,125,0)');grad.addColorStop(.55,'rgba(255,226,125,.22)');grad.addColorStop(1,'rgba(255,252,224,1)');ctx.beginPath();ctx.moveTo(sx,sy);ctx.lineTo(x,y);ctx.lineWidth=5.1;ctx.strokeStyle=grad;ctx.shadowColor='rgba(255,229,130,.92)';ctx.shadowBlur=13;ctx.stroke();ctx.beginPath();ctx.moveTo(x-ux*8,y-uy*8);ctx.lineTo(x,y);ctx.lineWidth=2.15;ctx.strokeStyle='rgba(255,255,239,.98)';ctx.shadowColor='rgba(255,247,203,1)';ctx.shadowBlur=6;ctx.stroke();ctx.restore();renderTraceTipSparks(x,y,ux,uy,now)}
function traceBounds(){const pts=drawStrokes.flat();if(!pts.length)return{cx:canvas.width/2,cy:canvas.height/2,r:80};const xs=pts.map(p=>p.x),ys=pts.map(p=>p.y),minX=Math.min(...xs),maxX=Math.max(...xs),minY=Math.min(...ys),maxY=Math.max(...ys);return{cx:(minX+maxX)/2,cy:(minY+maxY)/2,r:Math.max(38,Math.max(maxX-minX,maxY-minY)*.48)}}
function buildFadeStardust(){const pts=[];drawStrokes.forEach((st,si)=>{if(st.length<2)return;const a=st[0],b=st[1],dx=b.x-a.x,dy=b.y-a.y,dist=Math.hypot(dx,dy)||1,count=Math.max(2,Math.floor(dist/22));for(let n=0;n<=count;n++){const t=n/count,seed=(si+1)*97+n*29,jitter=((seed*17)%11-5)*.45,nx=-dy/dist,ny=dx/dist;pts.push({x:a.x+dx*t+nx*jitter,y:a.y+dy*t+ny*jitter,vx:((seed%9)-4)*.055,vy:-.13-((seed*7)%8)*.018,delay:((seed*13)%100)/100*.28,size:.75+((seed*19)%9)/10})}});return pts.slice(0,150)}
function startDrawFadeOut(duration=880,onDone){drawTraceAnimation=null;drawStage.classList.remove('glowing');const start=performance.now();drawFadeAnimation={start,end:start+duration,onDone,finished:false,particles:buildFadeStardust()};compositeFrame(start)}
function renderDrawFade(now){const a=drawFadeAnimation;if(!a)return false;const t=Math.max(0,Math.min(1,(now-a.start)/Math.max(1,a.end-a.start))),alpha=1-Math.pow(t,1.45);renderInkLayer(alpha);ctx.save();for(const p of a.particles||[]){const local=Math.max(0,Math.min(1,(t-p.delay)/Math.max(.001,1-p.delay)));if(local<=0)continue;const drift=local*local*70,px=p.x+p.vx*drift+Math.sin(now*.006+(p.x+p.y)*.01)*3*local,py=p.y+p.vy*drift-local*7,pa=Math.sin(Math.PI*local)*.44*(1-t*.35);ctx.beginPath();ctx.fillStyle=`rgba(255,226,137,${pa})`;ctx.shadowColor='rgba(255,210,102,.65)';ctx.shadowBlur=6;ctx.arc(px,py,p.size*(.75+.35*(1-local)),0,Math.PI*2);ctx.fill()}ctx.restore();if(t>=1&&!a.finished){a.finished=true;const done=a.onDone;drawFadeAnimation=null;if(done)done()}return true}
function renderGoldRetrace(now){const a=drawTraceAnimation;if(!a)return false;const segs=a.segments;if(now<a.traceEnd){const target=(now-a.start)/Math.max(1,a.traceEnd-a.start)*a.totalLength;let walked=0;for(const seg of segs){if(target>=walked+seg.length){drawGoldLine(seg.a,seg.b,1,.82);walked+=seg.length;continue}if(target>walked){const p=(target-walked)/seg.length;drawGoldLine(seg.a,seg.b,p,.9);drawTraceLeadingEdge(seg.a,seg.b,p,now)}break}return true}segs.forEach(s=>drawGoldLine(s.a,s.b,1,1));const pulseT=Math.max(0,Math.min(1,(now-a.traceEnd)/Math.max(1,a.pulseEnd-a.traceEnd))),eased=1-Math.pow(1-pulseT,2.35),b=a.bounds,beat=.5+.5*Math.sin((now-a.traceEnd)*.0048);ctx.save();const haloRadius=b.r*(1.03+.2*eased+.05*beat),halo=ctx.createRadialGradient(b.cx,b.cy,0,b.cx,b.cy,haloRadius);halo.addColorStop(0,`rgba(255,231,145,${.045+.02*beat})`);halo.addColorStop(.34,`rgba(242,201,102,${.03+.012*beat})`);halo.addColorStop(.72,'rgba(230,181,66,.014)');halo.addColorStop(1,'rgba(230,181,66,0)');ctx.fillStyle=halo;ctx.beginPath();ctx.arc(b.cx,b.cy,haloRadius,0,Math.PI*2);ctx.fill();for(let i=0;i<3;i++){const start=i*.18,local=Math.max(0,Math.min(1,(pulseT-start)/.72));if(local<=0)continue;const ease=1-Math.pow(1-local,2.15),radius=b.r*(.48+i*.06+ease*1.08),alpha=Math.pow(1-local,1.45)*(.19-i*.03);ctx.beginPath();ctx.arc(b.cx,b.cy,radius,0,Math.PI*2);ctx.lineWidth=1.5-i*.18;ctx.strokeStyle=`rgba(246,211,113,${Math.max(0,alpha)})`;ctx.shadowColor=`rgba(255,220,118,${Math.max(0,alpha*.72)})`;ctx.shadowBlur=8;ctx.stroke()}ctx.restore();if(!a.completed&&now>=a.traceEnd){a.completed=true;drawStage.classList.add('glowing');if(a.onTraceComplete)a.onTraceComplete()}if(now>=a.end){drawTraceAnimation=null;drawStage.classList.remove('glowing');rebuildInkLayer()}return true}
function startGoldRetrace(onTraceComplete)