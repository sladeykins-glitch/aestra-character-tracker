<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Aestran Decoder — Player Archive</title>
<style>
:root{--bg:#0b0f15;--bg2:#10151d;--panel:#151b24;--panel2:#101620;--text:#f0eee7;--muted:#97a1ad;--faint:#66717e;--line:#28313c;--gold:#d8c17c;--gold2:#f0d991;--accent:#d8c17c;--accent-strong:#f0d991;--border-soft:#222a33;--good:#97bea0;--warn:#d3ad70;--bad:#c98585;--radius:17px;--shadow:0 20px 55px rgba(0,0,0,.28)}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font:14px/1.55 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,sans-serif}button,input,textarea{font:inherit;color:inherit}button{cursor:pointer}body{background:radial-gradient(circle at 78% -8%,rgba(216,193,124,.08),transparent 28%),radial-gradient(circle at 8% 110%,rgba(87,106,145,.07),transparent 32%),var(--bg)}
.app{min-height:100vh;display:grid;grid-template-columns:205px minmax(0,1fr)}.sidebar{height:100vh;position:sticky;top:0;border-right:1px solid #222a34;background:rgba(13,18,25,.95);padding:24px 15px;backdrop-filter:blur(18px);overflow:auto}.brand{font-size:17px;font-weight:850;letter-spacing:.02em;padding:0 8px}.brand:before{content:'◇';color:var(--gold);margin-right:9px}.sub{font-size:11px;color:var(--muted);padding:3px 8px 0}.nav{display:grid;gap:4px;margin-top:30px}.nav button{border:0;background:transparent;text-align:left;padding:10px 11px;border-radius:10px;color:#bac2cc;transition:.15s}.nav button:hover{background:rgba(255,255,255,.04);color:#fff}.nav button.active{background:rgba(216,193,124,.10);color:#fff}.sidecard{margin-top:26px;padding-top:18px;border-top:1px solid #222a34;display:grid;gap:9px}.sidecard .small{font-size:11px;color:var(--muted)}
.main{padding:32px clamp(22px,4vw,58px) 60px;max-width:1500px;width:100%;margin:0 auto}.topbar{display:flex;justify-content:space-between;gap:18px;align-items:center;padding-bottom:17px;margin-bottom:28px;border-bottom:1px solid #222a34}.topbar h1{font-size:25px;line-height:1.2;margin:0;letter-spacing:-.025em}.row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.pill{display:inline-flex;border:1px solid #34404c;border-radius:999px;padding:4px 9px;font-size:10px;color:var(--muted)}.pill.good{border-color:#405948;color:#c7dfcc}.pill.warn{border-color:#665437;color:#e1c58f}.btn{border:1px solid #313b46;background:#151b23;padding:9px 12px;border-radius:9px;transition:.15s}.btn:hover{background:#1c232d;border-color:#465361}.btn.primary{background:var(--gold);border-color:var(--gold);color:#15120c;font-weight:800}.btn.ghost{background:transparent;color:var(--muted)}.screen{display:none}.screen.active{display:block;animation:in .18s ease}@keyframes in{from{opacity:.3;transform:translateY(4px)}to{opacity:1;transform:none}}.grid2{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:25px;align-items:start}.stack{display:grid;gap:16px}.card{background:linear-gradient(180deg,rgba(25,31,40,.95),rgba(19,24,32,.96));border:1px solid #222b35;border-radius:var(--radius);padding:20px;box-shadow:0 1px 0 rgba(255,255,255,.02)}h2{font-size:19px;margin:0}h3{font-size:10px;text-transform:uppercase;letter-spacing:.13em;color:var(--muted);margin:0}.muted{color:var(--muted)}aside .card{background:transparent;border:0;border-left:1px solid #222b35;border-radius:0;padding:4px 0 4px 20px;box-shadow:none}.stats{display:flex;gap:8px;flex-wrap:wrap;margin-top:15px}.stat{border:1px solid #27313c;border-radius:999px;padding:5px 10px;color:#aab4bf;font-size:11px}.stat b{color:#eee9dc}.empty{border:1px dashed #2e3945;border-radius:15px;padding:30px;text-align:center;color:var(--muted)}
svg path,svg circle,svg line,svg rect{fill:none;stroke:currentColor;stroke-width:3.25;stroke-linecap:round;stroke-linejoin:round;vector-effect:non-scaling-stroke}.rune{display:inline-grid;place-items:center}.rune svg{display:block}.glyphline{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:16px}.glyphcard{display:grid;place-items:center;min-width:96px;padding:10px;border:1px solid #252f3a;border-radius:13px;background:rgba(9,13,19,.52)}.glyphcard svg{width:72px;height:72px;color:#eee8d7}.archive-item{position:relative;padding:19px;margin-top:14px;border:1px solid rgba(216,193,124,.14);border-radius:17px;background:linear-gradient(180deg,rgba(22,28,36,.86),rgba(13,18,25,.93));overflow:hidden}.archive-item:after{content:'✦';position:absolute;right:16px;bottom:9px;color:rgba(216,193,124,.16);font-size:22px}.archive-head{display:flex;justify-content:space-between;gap:12px}.archive-title{font-weight:800;font-size:15px}.reading{margin-top:14px;padding-top:12px;border-top:1px solid #27303a;color:#d7dde4}.reading .unknown{color:#778491}.note{margin-top:14px}.note textarea{width:100%;resize:vertical;background:#0e141c;border:1px solid #2b3541;border-radius:10px;padding:10px 11px;outline:none}.note textarea:focus{border-color:#6a5d3b;box-shadow:0 0 0 3px rgba(216,193,124,.06)}
.timeline{position:relative;display:grid;gap:16px;margin-top:18px}.timeline:before{content:'';position:absolute;left:18px;top:10px;bottom:10px;width:1px;background:linear-gradient(var(--gold),#2b3541 70%,transparent)}.discovery{position:relative;margin-left:40px;border:1px solid rgba(216,193,124,.13);border-radius:15px;padding:16px 17px;background:rgba(16,22,30,.72)}.discovery:before{content:'';position:absolute;left:-28px;top:20px;width:9px;height:9px;border-radius:50%;background:var(--gold);box-shadow:0 0 15px rgba(216,193,124,.4)}.discovery .label{font-weight:800}.echo{margin-top:10px;padding:10px 12px;border-left:2px solid rgba(216,193,124,.45);background:rgba(216,193,124,.035);font-size:11px}.echo b{color:#e9ddbd}
.lexhead{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.bubble-stage{height:620px;position:relative;overflow:hidden;margin-top:14px;border:1px solid rgba(216,193,124,.11);border-radius:20px;background:radial-gradient(circle at 50% 46%,rgba(50,62,95,.18),transparent 32%),linear-gradient(180deg,#090d15,#0d1421);touch-action:none;transition:height .28s ease}.bubble-stage:after{content:'';position:absolute;inset:0;pointer-events:none;background-image:radial-gradient(circle,rgba(240,217,145,.35) 0 1px,transparent 1.5px);background-size:145px 145px;opacity:.22}.bubble{--bubble-visual:104px;--bubble-hit:104px;position:absolute;width:var(--bubble-hit);height:var(--bubble-hit);display:grid;place-items:center;border:0;padding:0;background:transparent;z-index:2;user-select:none;touch-action:none;overflow:visible}.bubble-visual{position:relative;width:var(--bubble-visual);height:var(--bubble-visual);border-radius:50%;display:grid;place-items:center;border:1px solid rgba(216,193,124,.15);background:radial-gradient(circle at 35% 28%,rgba(216,193,124,.09),rgba(11,16,25,.82) 62%);box-shadow:0 13px 30px rgba(0,0,0,.24),inset 0 0 24px rgba(216,193,124,.025);transition:transform .2s cubic-bezier(.2,.8,.2,1),border-color .15s,box-shadow .15s;pointer-events:none}.bubble:hover .bubble-visual,.bubble.active .bubble-visual{border-color:rgba(240,217,145,.42);box-shadow:0 15px 35px rgba(0,0,0,.3),0 0 22px rgba(216,193,124,.10)}.bubble.active .bubble-visual{transform:scale(1.16);z-index:3}.bubble.dragging .bubble-visual{transform:scale(1.08);border-color:rgba(255,238,184,.62);box-shadow:0 17px 38px rgba(0,0,0,.32),0 0 25px rgba(216,193,124,.13)}.bubble.pinned .bubble-visual:after{content:'·';position:absolute;right:12%;top:5%;color:var(--gold);font-size:clamp(14px,20%,22px)}.bubble svg{width:62%!important;height:62%!important;color:#ede7d4;pointer-events:none}.bubble-name{position:absolute;bottom:7%;left:8%;right:8%;font-size:9px;line-height:1;letter-spacing:.07em;color:#9fa8b4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:center}.bubble-stage[data-density=small] .bubble-name{font-size:8px}.bubble-stage[data-density=tiny] .bubble-name{font-size:7px;letter-spacing:.035em;bottom:5%}.bubble-stage[data-density=tiny] .bubble svg{width:59%!important;height:59%!important}.lexdetail{min-height:240px}.lexhero{display:grid;place-items:center;padding:15px}.lexhero svg{width:115px;height:115px;color:#f1e7c7;filter:drop-shadow(0 0 12px rgba(216,193,124,.13))}.meanings{display:flex;gap:7px;flex-wrap:wrap}.meaning{border:1px solid #3c493e;border-radius:999px;padding:4px 8px;font-size:11px;color:#c7dfcc}.meaning.sus{border-color:#655438;color:#e1c58f}.layout-tools{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}
.draw-stage{background:radial-gradient(circle at 50% 35%,rgba(35,41,67,.35),transparent 24%),linear-gradient(180deg,#070a12,#0a1020 58%,#06090f);border:1px solid rgba(216,193,124,.18);border-radius:22px;padding:18px;box-shadow:0 24px 55px rgba(0,0,0,.34),inset 0 0 0 1px rgba(255,255,255,.03);position:relative;overflow:hidden;transition:box-shadow .35s ease,filter .35s ease,transform .35s ease;min-height:0}
.draw-stage:before{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 20% 16%,rgba(79,94,157,.11),transparent 18%),radial-gradient(circle at 80% 24%,rgba(255,218,120,.045),transparent 14%),radial-gradient(circle at 62% 74%,rgba(92,109,172,.08),transparent 18%);mix-blend-mode:screen}
.draw-stage:after{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(115deg,transparent 12%,rgba(255,233,161,.035) 34%,transparent 48%),radial-gradient(circle at 50% 50%,rgba(255,240,189,.045),transparent 40%);mix-blend-mode:screen;opacity:.9}
.calligraphy-wrap{position:relative;z-index:1;border-radius:16px;overflow:hidden}
#drawCanvas{width:min(100%,720px);height:auto;min-height:0;aspect-ratio:1/1;margin:0 auto;display:block;background:transparent;border:0;border-radius:16px;box-shadow:none;touch-action:none}
.ink-hint{font-size:12px;color:#b9a978}.ink-hint b{color:#f0d88f;text-shadow:0 0 8px rgba(240,216,143,.16)}
.draw-stage.glowing{animation:voidPulse 1.95s ease-in-out 1;filter:saturate(1.1) brightness(1.03);box-shadow:0 24px 55px rgba(0,0,0,.34),0 0 0 1px rgba(244,214,127,.2),0 0 26px rgba(230,186,83,.12),inset 0 0 28px rgba(245,216,126,.035)}
.draw-stage.glowing:after{animation:goldSweep 1.4s ease-out 1}
.draw-result-card{background:rgba(18,22,28,.8);border:1px solid rgba(216,193,124,.12);border-radius:18px;padding:18px;position:relative;overflow:hidden}
.draw-result-card:before{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(110deg,transparent 20%,rgba(234,214,149,.04) 45%,transparent 70%);transform:translateX(-120%)}
.draw-result-card.answered:before{animation:resultSweep 1.4s ease-out}.draw-result-card.answered{border-color:rgba(234,214,149,.3);box-shadow:0 0 20px rgba(216,193,124,.08)}
.draw-result-card h3{font-size:11px;color:#d7dde4;letter-spacing:.12em}.draw-result-card .muted{line-height:1.5}
.draw-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-top:14px}.draw-toolbar-group{display:flex;gap:9px;flex-wrap:wrap;align-items:center}.draw-toolbar-group.accent{padding:6px;border:1px solid rgba(216,193,124,.14);border-radius:14px;background:rgba(216,193,124,.035)}.draw-toolbar .btn{min-height:38px}.draw-toolbar .btn.primary{min-width:146px}
.draw-mode-strip{margin-top:14px;padding:14px 16px;border:1px solid rgba(216,193,124,.14);border-radius:16px;background:linear-gradient(180deg,rgba(17,21,28,.74),rgba(12,16,23,.82));box-shadow:inset 0 1px 0 rgba(255,255,255,.025)}.draw-mode-kicker{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--faint);font-weight:800}.draw-mode-line{display:flex;gap:10px;align-items:flex-start;margin-top:8px;flex-wrap:wrap}.draw-mode-badge{font-weight:700;color:var(--text)}.draw-mode-badge.good{border-color:rgba(144,183,154,.38);color:#d6eadb}.draw-mode-badge.warn{border-color:rgba(216,193,124,.36);color:#f0ddb2}.draw-mode-copy{min-width:0;flex:1;color:#c3ccd6;line-height:1.48;padding-top:2px}.draw-quick-tips{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.draw-quick-tips span{display:inline-flex;align-items:center;gap:6px;border:1px solid rgba(85,103,126,.28);border-radius:999px;padding:4px 9px;background:rgba(77,93,114,.08);font-size:11px;color:#b8c3cf}.draw-quick-tips span:before{content:'✦';font-size:10px;color:var(--accent)}
#draw .grid2{grid-template-columns:minmax(0,1fr) 235px;gap:22px}#draw .card:first-child{padding:22px;position:relative;overflow:hidden}#draw .card:first-child:before{content:'';position:absolute;inset:-25% -10% auto auto;width:240px;height:240px;border-radius:50%;pointer-events:none;background:radial-gradient(circle,rgba(234,214,149,.08),transparent 65%);opacity:.8}#drawResult .row:first-child{align-items:flex-start}
.correction-guide{margin-top:14px;padding:12px;border:1px solid rgba(216,193,124,.18);border-radius:14px;background:rgba(8,12,22,.48)}.correction-guide-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-s