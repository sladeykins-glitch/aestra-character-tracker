{const segments=drawingSegments();if(!segments.length)return false;drawStage.classList.remove('glowing');const totalLength=segments.reduce((n,s)=>n+s.length,0),duration=Math.max(1450,Math.min(3600,totalLength*2.15)),start=performance.now(),traceEnd=start+duration,pulseEnd=traceEnd+1750;drawTraceAnimation={segments,totalLength,start,traceEnd,pulseEnd,end:pulseEnd+260,bounds:traceBounds(),completed:false,onTraceComplete};compositeFrame(start);return true}
function cancelGoldRetrace(){drawTraceAnimation=null;drawFadeAnimation=null;drawStage.classList.remove('glowing')}
function compositeFrame(now=performance.now()){drawBackground(now);if(drawTraceAnimation)renderGoldRetrace(now);else if(drawFadeAnimation)renderDrawFade(now);else renderInkLayer(1);if(drawDragStart&&drawPreviewPoint&&!drawTraceAnimation&&!drawFadeAnimation){ctx.save();ctx.strokeStyle='rgba(216,232,255,.94)';ctx.shadowColor='rgba(111,170,255,.82)';ctx.shadowBlur=12;ctx.lineWidth=7;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(drawDragStart.x,drawDragStart.y);ctx.lineTo(drawPreviewPoint.x,drawPreviewPoint.y);ctx.stroke();ctx.shadowBlur=0;ctx.lineWidth=1.7;ctx.strokeStyle='rgba(240,216,143,.9)';ctx.fillStyle='rgba(240,216,143,.15)';[drawDragStart,drawPreviewPoint].forEach(p=>{ctx.beginPath();ctx.arc(p.x,p.y,8,0,Math.PI*2);ctx.fill();ctx.stroke()});ctx.restore()}else if(drawHoverPoint&&!drawTraceAnimation&&!drawFadeAnimation){ctx.save();ctx.strokeStyle='rgba(240,216,143,.72)';ctx.fillStyle='rgba(240,216,143,.14)';ctx.lineWidth=1.5;ctx.beginPath();ctx.arc(drawHoverPoint.x,drawHoverPoint.y,7,0,Math.PI*2);ctx.fill();ctx.stroke();ctx.restore()}}
function drawCanvas(){compositeFrame()}
function ambientLoop(now){if(drawTraceAnimation||drawFadeAnimation||now-lastAmbientFrame>33){compositeFrame(now);lastAmbientFrame=now}requestAnimationFrame(ambientLoop)}requestAnimationFrame(ambientLoop);
function sameGridPoint(a,b){return!!a&&!!b&&a.gx===b.gx&&a.gy===b.gy}
function commitGridSegment(a,b){if(!a||!b||sameGridPoint(a,b))return false;const t=performance.now(),start={...a,t,w:7.2},finish={...b,t:t+24,w:7.2};drawStrokes.push([start,finish]);paintNormalDab(start);paintNormalSegment(start,finish);paintNormalDab(finish);return true}
function resetDrawingState(){cancelGoldRetrace();drawStrokes=[];drawHoverPoint=null;drawDragStart=null;drawPreviewPoint=null;drawPointerId=null;inkCtx.clearRect(0,0,inkCanvas.width,inkCanvas.height);compositeFrame()}
function clearDrawing(){resetDrawingState()}
function setDrawMode(label,copy,tone='good'){const b=$('drawModeBadge'),d=$('drawModeCopy');if(b){b.textContent=label;b.className='pill draw-mode-badge '+tone}if(d)d.innerHTML=copy}
function freeDrawModeCopy(){return knownRuneCandidates().length?'Draw any rune the party knows, then press <b>Analyse drawing</b> to see what the inscription means.':'The party has not discovered any glyphs yet. You can still copy an unknown sign, but the decoder cannot identify it until it enters the lexicon.'}
function clearPracticeTimer(){if(practiceTimer){clearTimeout(practiceTimer);practiceTimer=null}}
function setPracticeDemoControls(v){['undoDraw','clearDraw','recogniseDraw'].forEach(id=>{const el=$(id);if(el)el.disabled=!!v})}
function clearRandomReference(message){if(!randomReferenceActive)return false;randomReferenceActive=false;randomReferenceTarget=null;analysisInProgress=false;resetDrawingState();setDrawMode('Free draw',freeDrawModeCopy(),'good');$('drawResult').innerHTML=message||'<b>Reference cleared.</b><div class="muted">Now draw the rune yourself, then analyse your version.</div>';$('drawResultCard').classList.remove('answered');return true}
function cancelDrawAnalysis(message){if(!analysisInProgress)return false;analysisInProgress=false;cancelGoldRetrace();if(practicePhase==='draw'&&practiceTarget)setDrawMode('Practice · Your turn','Keep refining <b>'+esc(practiceTarget.id)+'</b>, then analyse again when you are ready.','good');else setDrawMode('Free draw',freeDrawModeCopy(),'good');if(message)$('drawResult').innerHTML=message;return true}
canvas.onpointerdown=e=>{if(practicePhase==='demo')beginPracticeAttempt();else if(randomReferenceActive)clearRandomReference('<b>Your turn.</b><div class="muted">The Random reference has been cleared. Draw the rune from memory.</div>');else if(analysisInProgress)cancelDrawAnalysis('<b>Analysis cancelled.</b><div class="muted">Your drawing is still here. The new stroke will be included when you analyse again.</div>');cancelGoldRetrace();const p=canvasPos(e);drawHoverPoint=p;drawDragStart=p;drawPreviewPoint=p;drawPointerId=e.pointerId;canvas.setPointerCapture(e.pointerId);compositeFrame()};
canvas.onpointermove=e=>{const p=canvasPos(e);drawHoverPoint=p;if(drawDragStart&&(drawPointerId===null||e.pointerId===drawPointerId))drawPreviewPoint=p;compositeFrame()};
canvas.onpointerup=e=>{const p=canvasPos(e);if(drawDragStart&&(drawPointerId===null||e.pointerId===drawPointerId))commitGridSegment(drawDragStart,p);drawDragStart=null;drawPreviewPoint=null;drawPointerId=null;drawHoverPoint=p;try{canvas.releasePointerCapture(e.pointerId)}catch(_){}compositeFrame()};canvas.onpointercancel=()=>{drawDragStart=null;drawPreviewPoint=null;drawPointerId=null;compositeFrame()};canvas.onpointerleave=()=>{if(!drawDragStart)drawHoverPoint=null;compositeFrame()};
$('undoDraw').onclick=()=>{if(randomReferenceActive){clearRandomReference('<b>Reference cleared.</b><div class="muted">Random demonstrations are reference shapes, not part of your drawing. Start your own rune now.</div>');return}if(analysisInProgress)cancelDrawAnalysis();if(drawStrokes.length)drawStrokes.pop();cancelGoldRetrace();rebuildInkLayer();$('drawResult').innerHTML=practicePhase==='draw'?(drawStrokes.length?'Last line removed.':'<b>Your turn.</b><div class="muted">Redraw <b>'+esc(practiceTarget?.id||'the rune')+'</b> from memory.</div>'):(drawStrokes.length?'Last line removed.':'Draw something first.');compositeFrame()};
$('clearDraw').onclick=()=>{if(randomReferenceActive){clearRandomReference('<b>Reference cleared.</b><div class="muted">The canvas is ready for your own drawing.</div>');return}analysisInProgress=false;resetDrawingState();$('drawResult').innerHTML=practicePhase==='draw'?'<b>Canvas cleared.</b><div class="muted">Redraw <b>'+esc(practiceTarget?.id||'the rune')+'</b> from memory.</div>':'Draw something first.';if(practicePhase==='draw')setDrawMode('Practice · Your turn','Redraw <b>'+esc(practiceTarget?.id||'the rune')+'</b> from memory.','good');else setDrawMode('Free draw',freeDrawModeCopy(),'good')};
function parseCanonicalGridSegments(path){const tokens=path.match(/[MLHVZ]|-?\d+(?:\.\d+)?/g)||[],segs=[];let i=0,cmd=null,x=0,y=0,sx=0,sy=0;const num=()=>Number(tokens[i++]);while(i<tokens.length){if(/^[MLHVZ]$/.test(tokens[i]))cmd=tokens[i++];if(cmd==='M'){x=num();y=num();sx=x;sy=y;cmd='L'}else if(cmd==='L'){const nx=num(),ny=num();segs.push([{x,y},{x:nx,y:ny}]);x=nx;y=ny}else if(cmd==='H'){const nx=num();segs.push([{x,y},{x:nx,y}]);x=nx}else if(cmd==='V'){const ny=num();segs.push([{x,y},{x,y:ny}]);y=ny}else if(cmd==='Z'){if(x!==sx||y!==sy)segs.push([{x,y},{x:sx,y:sy}]);x=sx;y=sy;cmd=null}else break}return segs}
function writeOrderToDrawStrokes(order){const g=drawGridMetrics(),now=performance.now(),pt=(gx,gy,i)=>({x:g.x0+gx*g.step,y:g.y0+gy*g.step,gx,gy,t:now+i*28,w:7.2});return(order||[]).map((s,i)=>[pt(s[0],s[1],i*2),pt(s[2],s[3],i*2+1)])}
function canonicalPathToDrawStrokes(path){const g=drawGridMetrics(),now=performance.now(),toPoint=(p,i)=>{const gx=Math.max(0,Math.min(8,Math.round((p.x-14)/9))),gy=Math.max(0,Math.min(8,Math.round((p.y-14)/9)));return{x:g.x0+gx*g.step,y:g.y0+gy*g.step,gx,gy,t:now+i*28,w:7.2}};return parseCanonicalGridSegments(path).map((s,i)=>[toPoint(s[0],i*2),toPoint(s[1],i*2+1)])}
function knownRuneCandidates(){const out=[];knownRoots().forEach(r=>out.push({id:r.id,type:'root',path:r.svgPath,writeOrder:r.writeOrder||[],writeOrderRule:r.writeOrderRule||'',raw:r}));knownCompounds().forEach(c=>out.push({id:c.id,type:'compound',path:c.canonicalPath,writeOrder:c.writeOrder||[],writeOrderRule:c.writeOrderRule||'',raw:c}));return out}
function randomKnownRune(){const pool=knownRuneCandidates();if(!pool.length)return null;let choices=pool.filter(x=>x.id!==lastRandomRuneId);if(!choices.length)choices=pool;const pick=choices[Math.floor(Math.random()*choices.length)];lastRandomRuneId=pick.id;return pick}
function canonicalRuneDrawStrokes(item){return item?.writeOrder?.length?writeOrderToDrawStrokes(item.writeOrder):canonicalPathToDrawStrokes(item?.path||'')}
function practiceReading(item){return item?conceptReading(item.id):''}
function resetDrawForPractice(message){randomReferenceActive=false;randomReferenceTarget=null;analysisInProgress=false;resetDrawingState();if(message)$('drawResult').innerHTML=message}
function beginPracticeAttempt(){if(!practiceTarget)return;clearPracticeTimer();practicePhase='draw';setPracticeDemoControls(false);setDrawMode('Practice · Your turn','Redraw <b>'+esc(practiceTarget.id)+'</b> from memory, then press <b>Analyse drawing</b>.','good');resetDrawForPractice('<b>Your turn.</b><div class="muted">Redraw <b>'+esc(practiceTarget.id)+'</b> from memory, then press <b>Analyse drawing</b>.</div>')}
function startPracticeRune(){const pick=randomKnownRune();if(!pick){$('drawResult').innerHTML='<b>No runes available for practice.</b><div class="muted">The party must first discover a glyph.</div>';setDrawMode('No known runes','Discover a glyph before using Practice.','warn');return;}clearPracticeTimer();randomReferenceActive=false;randomReferenceTarget=null;analysisInProgress=false;practiceTarget=pick;practicePhase='demo';setPracticeDemoControls(true);setDrawMode('Practice · Memorise','Watch the rune being written, remember the shape, and wait for the canvas to hand back to you.','warn');cancelGoldRetrace();drawStrokes=canonicalRuneDrawStrokes(pick);rebuildInkLayer();const result=$('drawResult'),rc=$('drawResultCard');rc.classList.remove('answered');result.innerHTML='<b>Memorise this rune.</b><div class="muted">Watch <b>'+esc(pick.id)+'</b> being written. It will disappear when the demonstration finishes.</div>';startGoldRetrace(()=>{if(practicePhase!=='demo'||practiceTarget!==pick)return;rc.classList.remove('answered');void rc.offsetWidth;rc.classList.add('answered');result.innerHTML='<div class="row">'+runeSVG(pick.id,82)+'<div><b>'+esc(pick.id)+'</b><div class="muted">'+esc(practiceReading(pick))+' · remember the shape</div></div></div>';practiceTimer=setTimeout(()=>{if(practicePhase==='demo'&&practiceTarget===pick)startDrawFadeOut(880,()=>{if(practicePhase==='demo'&&practiceTarget===pick)beginPracticeAttempt()})},700)})}
function loadRandomRune(){clearPracticeTimer();practiceTarget=null;practicePhase='idle';setPracticeDemoControls(false);analysisInProgress=false;setDrawMode('Random demo','A known rune will retrace its canonical stroke order. When you start drawing, the reference will clear automatically.','warn');const pick=randomKnownRune();if(!pick){$('drawResult').innerHTML='<b>No runes available yet.</b><div class="muted">The party must first discover a glyph before Random can demonstrate one.</div>';setDrawMode('No known runes','Discover a glyph before using Random.','warn');return;}randomReferenceTarget=pick;randomReferenceActive=true;cancelGoldRetrace();drawStrokes=canonicalRuneDrawStrokes(pick);rebuildInkLayer();const result=$('drawResult'),rc=$('drawResultCard');rc.classList.remove('answered');result.innerHTML='<b>Random rune selected.</b><div class="muted">Watch the canonical writing order. The reference will disappear as soon as you begin your own drawing.</div>';startGoldRetrace(()=>{if(!randomReferenceActive||randomReferenceTarget!==pick)return;rc.classList.remove('answered');void rc.offsetWidth;rc.classList.add('answered');result.innerHTML='<div class="row">'+runeSVG(pick.id,90)+'<div><b>'+esc(pick.id)+'</b><div class="muted">'+esc(practiceReading(pick))+' · '+(pick.writeOrder?.length||0)+' canonical strokes</div><div style="margin-top:5px">Begin drawing when you are ready — the reference will clear on your first stroke.</div></div></div>';setDrawMode('Random · Your turn','Memorise <b>'+esc(pick.id)+'</b>, then begin drawing. The reference clears automatically when you touch the canvas.','good')})}
$('sampleCrystal').onclick=loadRandomRune;$('practiceRune').onclick=startPracticeRune;
function gcdInt(a,b){a=Math.abs(Math.round(a));b=Math.abs(Math.round(b));while(b){const t=b;b=a%b;a=t}return a||1}
function undirectedEdgeKey(ax,ay,bx,by){const a=ax+','+ay,b=bx+','+by;return a<b?a+'|'+b:b+'|'+a}
function primitiveEdgesForGridSegment(a,b){const dx=b.gx-a.gx,dy=b.gy-a.gy,steps=gcdInt(dx,dy),sx=dx/steps,sy=dy/steps,edges=[];let x=a.gx,y=a.gy;for(let i=0;i<steps;i++){const nx=x+sx,ny=y+sy;edges.push({ax:x,ay:y,bx:nx,by:ny});x=nx;y=ny}return edges}
