iceDemoControls(true);setDrawMode('Practice · Memorise','Watch the rune being written, remember the shape, and wait for the canvas to hand back to you.','warn');cancelGoldRetrace();drawStrokes=canonicalRuneDrawStrokes(pick);rebuildInkLayer();const result=$('drawResult'),rc=$('drawResultCard');rc.classList.remove('answered');result.innerHTML='<b>Memorise this rune.</b><div class="muted">Watch <b>'+esc(pick.id)+'</b> being written. It will disappear when the demonstration finishes.</div>';startGoldRetrace(()=>{if(practicePhase!=='demo'||practiceTarget!==pick)return;rc.classList.remove('answered');void rc.offsetWidth;rc.classList.add('answered');result.innerHTML='<div class="row">'+runeSVG(pick.id,82)+'<div><b>'+esc(pick.id)+'</b><div class="muted">'+esc(practiceReading(pick))+' · remember the shape</div></div></div>';practiceTimer=setTimeout(()=>{if(practicePhase==='demo'&&practiceTarget===pick)startDrawFadeOut(880,()=>{if(practicePhase==='demo'&&practiceTarget===pick)beginPracticeAttempt()})},700)})}
function loadRandomRune(){clearPracticeTimer();practiceTarget=null;practicePhase='idle';setPracticeDemoControls(false);analysisInProgress=false;setDrawMode('Random demo','A known rune will retrace its canonical stroke order. When you start drawing, the reference will clear automatically.','warn');const pick=randomKnownRune();if(!pick){$('drawResult').innerHTML='<b>No runes available yet.</b><div class="muted">The party must first discover a glyph before Random can demonstrate one.</div>';setDrawMode('No known runes','Discover a glyph before using Random.','warn');return;}randomReferenceTarget=pick;randomReferenceActive=true;cancelGoldRetrace();drawStrokes=canonicalRuneDrawStrokes(pick);rebuildInkLayer();const result=$('drawResult'),rc=$('drawResultCard');rc.classList.remove('answered');result.innerHTML='<b>Random rune selected.</b><div class="muted">Watch the canonical writing order. The reference will disappear as soon as you begin your own drawing.</div>';startGoldRetrace(()=>{if(!randomReferenceActive||randomReferenceTarget!==pick)return;rc.classList.remove('answered');void rc.offsetWidth;rc.classList.add('answered');result.innerHTML='<div class="row">'+runeSVG(pick.id,90)+'<div><b>'+esc(pick.id)+'</b><div class="muted">'+esc(practiceReading(pick))+' · '+(pick.writeOrder?.length||0)+' canonical strokes</div><div style="margin-top:5px">Begin drawing when you are ready — the reference will clear on your first stroke.</div></div></div>';setDrawMode('Random · Your turn','Memorise <b>'+esc(pick.id)+'</b>, then begin drawing. The reference clears automatically when you touch the canvas.','good')})}
$('sampleCrystal').onclick=loadRandomRune;$('practiceRune').onclick=startPracticeRune;
function gcdInt(a,b){a=Math.abs(Math.round(a));b=Math.abs(Math.round(b));while(b){const t=b;b=a%b;a=t}return a||1}
function undirectedEdgeKey(ax,ay,bx,by){const a=ax+','+ay,b=bx+','+by;return a<b?a+'|'+b:b+'|'+a}
function primitiveEdgesForGridSegment(a,b){const dx=b.gx-a.gx,dy=b.gy-a.gy,steps=gcdInt(dx,dy),sx=dx/steps,sy=dy/steps,edges=[];let x=a.gx,y=a.gy;for(let i=0;i<steps;i++){const nx=x+sx,ny=y+sy;edges.push({ax:x,ay:y,bx:nx,by:ny});x=nx;y=ny}return edges}
function userGridEdges(){const edges=[];drawStrokes.filter(s=>s.length>1).forEach(st=>edges.push(...primitiveEdgesForGridSegment(st[0],st[1])));const unique=new Map();edges.forEach(e=>unique.set(undirectedEdgeKey(e.ax,e.ay,e.bx,e.by),e));return[...unique.values()]}
function canonicalPathGridEdges(path){const toGrid=p=>({gx:Math.round((p.x-14)/9),gy:Math.round((p.y-14)/9)}),edges=[];parseCanonicalGridSegments(path).forEach(s=>edges.push(...primitiveEdgesForGridSegment(toGrid(s[0]),toGrid(s[1]))));const unique=new Map();edges.forEach(e=>unique.set(undirectedEdgeKey(e.ax,e.ay,e.bx,e.by),e));return[...unique.values()]}
function shiftedEdgeKey(e,dx,dy){return undirectedEdgeKey(e.ax+dx,e.ay+dy,e.bx+dx,e.by+dy)}function edgeBounds(edges){if(!edges.length)return{minX:0,maxX:0,minY:0,maxY:0};const xs=[],ys=[];edges.forEach(e=>{xs.push(e.ax,e.bx);ys.push(e.ay,e.by)});return{minX:Math.min(...xs),maxX:Math.max(...xs),minY:Math.min(...ys),maxY:Math.max(...ys)}}
function bestTranslatedGridScore(userEdges,canonEdges){if(!userEdges.length||!canonEdges.length)return{score:0,hits:0,dx:0,dy:0};const userSet=new Set(userEdges.map(e=>undirectedEdgeKey(e.ax,e.ay,e.bx,e.by))),ub=edgeBounds(userEdges),cb=edgeBounds(canonEdges),baseDx=Math.round((ub.minX+ub.maxX-cb.minX-cb.maxX)/2),baseDy=Math.round((ub.minY+ub.maxY-cb.minY-cb.maxY)/2);let best={score:0,hits:0,dx:0,dy:0};for(let dx=baseDx-4;dx<=baseDx+4;dx++)for(let dy=baseDy-4;dy<=baseDy+4;dy++){let hits=0;canonEdges.forEach(e=>{if(userSet.has(shiftedEdgeKey(e,dx,dy)))hits++});const precision=hits/userEdges.length,recall=hits/canonEdges.length,f1=precision&&recall?2*precision*recall/(precision+recall):0,countRatio=Math.min(userEdges.length,canonEdges.length)/Math.max(userEdges.length,canonEdges.length),score=f1*.88+countRatio*.12;if(score>best.score)best={score,hits,dx,dy,precision,recall}}return best}
function recogniserConfusionProfile(candidates){const profile=new Map(),edges=new Map(candidates.map(c=>[c.id,canonicalPathGridEdges(c.path)]));candidates.forEach(c=>profile.set(c.id,{nearestId:null,nearestSimilarity:0}));for(let i=0;i<candidates.length;i++)for(let j=i+1;j<candidates.length;j++){const a=candidates[i],b=candidates[j],similarity=bestTranslatedGridScore(edges.get(a.id),edges.get(b.id)).score;if(similarity>(profile.get(a.id)?.nearestSimilarity||0))profile.set(a.id,{nearestId:b.id,nearestSimilarity:similarity});if(similarity>(profile.get(b.id)?.nearestSimilarity||0))profile.set(b.id,{nearestId:a.id,nearestSimilarity:similarity})}return profile}
function recognitionThresholds(nearestSimilarity=0){const close=Math.max(0,nearestSimilarity-.55);return{requiredGap:.035+close*.22,acceptThreshold:62+Math.max(0,nearestSimilarity-.65)*30,definitiveThreshold:78+Math.max(0,nearestSimilarity-.65)*45}}
function recogniseGridRune(){const userEdges=userGridEdges();if(!userEdges.length)return null;const candidates=knownRuneCandidates(),ranked=candidates.map(c=>({...c,...bestTranslatedGridScore(userEdges,canonicalPathGridEdges(c.path))})).sort((a,b)=>b.score-a.score),best=ranked[0],second=ranked[1];if(!best)return null;const confusion=recogniserConfusionProfile(candidates).get(best.id)||{nearestId:null,nearestSimilarity:0},thresholds=recognitionThresholds(confusion.nearestSimilarity),gap=second?best.score-second.score:1,exact=best.score>=.999&&best.precision>=.999&&best.recall>=.999,ambiguous=!exact&&!!second&&second.score>=.42&&gap<thresholds.requiredGap,marginQuality=Math.max(0,Math.min(1,gap/Math.max(.001,thresholds.requiredGap))),penalty=ambiguous?(1-marginQuality)*10:0,confidence=exact?100:Math.round(Math.max(0,Math.min(99,best.score*100-penalty)));return{best,second,confidence,ambiguous,acceptThreshold:thresholds.acceptThreshold,definitiveThreshold:thresholds.definitiveThreshold,nearestRuneId:confusion.nearestId,nearestSimilarity:confusion.nearestSimilarity,exact}}
function correctionGuideHTML(rec,title='Stroke guide'){if(!rec?.best?.path)return'';const userEdges=userGridEdges(),canonRaw=canonicalPathGridEdges(rec.best.path),dx=rec.best.dx||0,dy=rec.best.dy||0,canonEdges=canonRaw.map(e=>({ax:e.ax+dx,ay:e.ay+dy,bx:e.bx+dx,by:e.by+dy})),userSet=new Set(userEdges.map(e=>undirectedEdgeKey(e.ax,e.ay,e.bx,e.by))),canonSet=new Set(canonEdges.map(e=>undirectedEdgeKey(e.ax,e.ay,e.bx,e.by))),shared=userEdges.filter(e=>canonSet.has(undirectedEdgeKey(e.ax,e.ay,e.bx,e.by))),extra=userEdges.filter(e=>!canonSet.has(undirectedEdgeKey(e.ax,e.ay,e.bx,e.by))),missing=canonEdges.filter(e=>!userSet.has(undirectedEdgeKey(e.ax,e.ay,e.bx,e.by))),p=v=>14+v*9,line=(e,stroke,width=2.4,dash='')=>`<line x1="${p(e.ax)}" y1="${p(e.ay)}" x2="${p(e.bx)}" y2="${p(e.by)}" style="stroke:${stroke};stroke-width:${width};stroke-linecap:round;fill:none;${dash?`stroke-dasharray:${dash};`:''}"/>`;let grid='',nodes='';for(let i=0;i<=8;i++){const v=14+i*9,col=i===4?'rgba(216,193,124,.15)':'rgba(147,173,215,.10)';grid+=`<line x1="14" y1="${v}" x2="86" y2="${v}" style="stroke:${col};stroke-width:.46;stroke-linecap:butt;fill:none;vector-effect:none"/><line x1="${v}" y1="14" x2="${v}" y2="86" style="stroke:${col};stroke-width:.46;stroke-linecap:butt;fill:none;vector-effect:none"/>`}for(let gy=0;gy<=8;gy++)for(let gx=0;gx<=8;gx++)nodes+=`<circle cx="${p(gx)}" cy="${p(gy)}" r=".46" style="fill:rgba(195,215,242,.17);stroke:none;vector-effect:none"/>`;return`<div class="correction-guide"><div class="correction-guide-head"><div><div class="correction-guide-title">${esc(title)} · ${esc(rec.best.id)}</div><div class="correction-guide-sub">This only compares your drawing with runes already known by the party. Hidden glyphs and meanings are never used here.</div></div><span class="pill">${rec.confidence}%</span></div><div class="correction-guide-body"><svg viewBox="0 0 100 100"><rect x="14" y="14" width="72" height="72" style="fill:none;stroke:rgba(216,193,124,.13);stroke-width:.5;vector-effect:none"/>${grid}${nodes}${userEdges.map(e=>line(e,'rgba(226,239,255,.84)',2.7)).join('')}${shared.map(e=>line(e,'rgba(250,253,255,1)',3)).join('')}${extra.map(e=>line(e,'rgba(118,153,200,.96)',3,'3 2')).join('')}${missing.map(e=>line(e,'rgba(240,216,143,.98)',3.2)).join('')}</svg><div class="correction-legend"><div class="correction-legend-row"><span class="guide-swatch"></span><span>Lines you placed correctly</span></div><div class="correction-legend-row"><span class="guide-swatch missing"></span><span>Gold = line still missing</span></div><div class="correction-legend-row"><span class="guide-swatch extra"></span><span>Blue dashed = extra line to remove</span></div><div class="correction-stats">${shared.length} matching · ${missing.length} missing · ${extra.length} extra</div></div></div></div>`}
function recognitionResultHTML(){if(!knownRuneCandidates().length)return'<b>No match in your known lexicon.</b><div class="muted">The party has not discovered any recognisable glyphs yet.</div>';const rec=recogniseGridRune();if(!rec)return'<b>No reliable match.</b><div class="muted">No drawing data.</div>';const c=rec.best,possible=rec.confidence<(rec.definitiveThreshold??78)||rec.ambiguous,alt=rec.ambiguous&&rec.second?rec.second.id:null,guide=(rec.confidence<100||rec.ambiguous)?correctionGuideHTML(rec,rec.ambiguous?'Compare the closest shapes':'Tighten the strokes'):'',close=rec.ambiguous&&rec.nearestSimilarity>=.68?'<div class="muted" style="margin-top:5px">This rune has a visually close neighbour, so the decoder is requiring a clearer distinction.</div>':'';if(rec.confidence<(rec.acceptThreshold??62))return'<b>No reliable match.</b><div class="muted">The grid pattern is not close enough to a rune the player currently knows. Closest known rune: '+esc(c.id)+' ('+rec.confidence+'%).</div>'+((rec.confidence>=18)?correctionGuideHTML(rec,'Closest known rune'):'');return'<div class="row">'+runeSVG(c.id,90)+'<div><b>'+(possible?'Possible rune: ':'Rune: ')+esc(c.id)+'</b><div class="muted">'+rec.confidence+'% grid match'+(alt?' · also resembles '+esc(alt):'')+'</div><div style="margin-top:5px">Known reading: <b>'+esc(conceptReading(c.id))+'</b></div>'+close+'</div></div>'+guide}
function practiceResultHTML(){if(!practiceTarget)return recognitionResultHTML();const userEdges=userGridEdges();if(!userEdges.length)return'<b>No attempt yet.</b><div class="muted">Redraw '+esc(practiceTarget.id)+' from memory first.</div>';const match=bestTranslatedGridScore(userEdges,canonicalPathGridEdges(practiceTarget.path)),confidence=Math.round(Math.max(0,Math.min(100,match.score*100))),rec={best:{...practiceTarget,...match},confidence,ambiguous:false},grade=confidence>=97?'Excellent memory':confidence>=88?'Very close':confidence>=74?'Nearly there':'Keep practising',note=confidence>=97?'You reproduced the rune almost exactly.':confidence>=88?'Only a small adjustment is needed.':confidence>=74?'The overall shape is there, but some strokes need tightening.':'Compare your attempt with the guide and try the same rune again.',guide=confidence<100?correctionGuideHTML(rec,'Practice correction'):'';return'<div class="row">'+runeSVG(practiceTarget.id,90)+'<div><b>'+esc(grade)+' · '+confidence+'%</b><div class="muted">Target: <b>'+esc(practiceTarget.id)+'</b> · '+esc(practiceReading(practiceTarget))+'</div><div style="margin-top:5px">'+esc(note)+'</div></div></div>'+guide+'<div class="row" style="margin-top:12px"><button class="btn" id="retryPractice">Try this rune again</button><button class="btn" id="nextPractice">New practice rune</button></div>'}
function bindPracticeResultActions(){const retry=$('retryPractice'),next=$('nextPractice');if(retry)retry.onclick=()=>beginPracticeAttempt();if(next)next.onclick=startPracticeRune}
$('recogniseDraw').onclick=()=>{const result=$('drawResult'),rc=$('drawResultCard');if(randomReferenceActive){clearRandomReference('<b>Draw your own version first.</b><div class="muted">The Random reference has been cleared so it cannot be mistaken for your attempt.</div>');return}if(!drawStrokes.some(s=>s.length>1)){result.innerHTML='<b>No reliable match.</b><div class="muted">No drawing data.</div>';return}const isPractice=practicePhase==='draw'&&practiceTarget,finalHTML=isPractice?practiceResultHTML():recognitionResultHTML();setDrawMode(isPractice?'Practice · Checking':'Analysis in progress',isPractice?'Comparing your memory of <b>'+esc(practiceTarget.id)+'</b> against the canonical rune.':'The inscription is retracing your stroke order to interpret the rune.','warn');result.innerHTML=isPractice?'<b>Checking your memory…</b><div class="muted">Comparing your attempt with the practice rune.</div>':'<b>Analysing…</b><div class="muted">The inscription is retracing your stroke order.</div>';rc.classList.remove('answered');analysisInProgress=true;startGoldRetrace(()=>{analysisInProgress=false;rc.classList.remove('answered');void rc.offsetWidth;rc.classList.add('answered');result.innerHTML=finalHTML;if(isPractice){practicePhase='review';setDrawMode('Practice · Review','Review the score, compare the shapes, then retry or move to a new rune.','good');bindPracticeResultActions()}else setDrawMode('Free draw','Draw another rune at any time, or tap <b>Random</b> / <b>Practice</b> for guided play.','good')})};
setDrawMode('Free draw',freeDrawModeCopy(),'good');compositeFrame();
function renderAll(){document.title='Aestran Decoder — v'+SNAP.publishedVersion;$('versionPill').textContent='v'+(SNAP.publishedVersion||'—');const knownCount=knownRoots().length+knownCompounds().length;$('snapshotStatus').textContent=`${liveJoined?'Live · ':''}Loaded ${SNAP.inscriptions.length} inscriptions · ${knownCount} recognisable signs.`;const randomBtn=$('sampleCrystal'),practiceBtn=$('practiceRune');if(randomBtn){randomBtn.disabled=!knownCount;randomBtn.title=knownCount?'Show a random known rune':'Discover a glyph before using Random'}if(practiceBtn){practiceBtn.disable