rune-review-card{padding:8px}}
.meter{height:6px;border-radius:999px;background:#0c1014;overflow:hidden}.meter div{height:100%;background:var(--accent)}.notice{border:1px solid rgba(216,193,124,.32);background:rgba(37,34,25,.85);border-radius:13px;padding:14px}
canvas{width:100%;height:320px;background:#10151b;border:1px dashed #303945;border-radius:14px;touch-action:none}.kpi{font-size:25px;font-weight:800;margin-top:4px}.listbtn{width:100%;text-align:left;border:0;border-bottom:1px solid var(--border-soft);background:transparent;padding:12px 3px;border-radius:0}.listbtn:hover{color:var(--accent-strong)}.listbtn.active{background:transparent;color:var(--accent);outline:0}.listbtn:last-child{border-bottom:0}
pre{white-space:pre-wrap;word-break:break-word;background:#0d1116;border:1px solid var(--border-soft);border-radius:12px;padding:14px;color:#cbd5df;max-height:420px;overflow:auto}
/* Main workspaces get visual priority */
#translator .stack>.card:first-child,#draw .stack>.card:first-child,#language .two-col>.card:last-child{box-shadow:var(--shadow)}
#translatorGlyphs{padding:22px 8px 6px;justify-content:center}#gmTruth,#playerTruth{font-size:14px;line-height:1.6}
.translation-mode-note{margin-top:10px;padding:10px 12px;border:1px solid var(--border-soft);border-radius:11px;background:rgba(255,255,255,.018);font-size:12px;color:var(--muted);line-height:1.5}
.translation-mode-note b{color:var(--text)}
.glyph-card.teaching-card{position:relative;display:flex;flex-direction:column;justify-content:flex-start;min-width:205px;max-width:205px;height:224px;padding:14px 12px 12px;overflow:hidden}
.teaching-structure{display:flex;align-items:center;justify-content:center;gap:7px;height:92px;min-height:92px;white-space:nowrap;overflow:hidden;margin-bottom:7px}
.teaching-part{display:grid;grid-template-rows:56px 14px;place-items:center;min-width:48px;max-width:58px}
.teaching-part svg{width:52px!important;height:52px!important}
.teaching-part-label{font-size:8px;line-height:1;letter-spacing:.06em;text-transform:uppercase;color:#8e9aa7;overflow:hidden;text-overflow:ellipsis;max-width:58px}
.teaching-connector{display:grid;place-items:center;min-width:18px;color:rgba(216,193,124,.76);font-size:18px;line-height:1;transform:translateY(-5px)}
.teaching-word{font-size:12px;font-weight:800;letter-spacing:.02em;margin-top:1px}
.teaching-gloss{height:28px;display:flex;align-items:flex-start;justify-content:center;padding-top:4px;color:#7f8b98;font-size:9px;line-height:1.35;overflow:hidden}
.teaching-footer{margin-top:auto;padding-top:8px;border-top:1px solid rgba(255,255,255,.055);font-size:8px;letter-spacing:.085em;text-transform:uppercase;color:#667381;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.teaching-footer .teaching-mod{color:#a9c5e7}
#translatorGlyphs:has(.teaching-card){align-items:stretch;gap:12px}
@media(max-width:700px){.glyph-card.teaching-card{min-width:180px;max-width:180px;height:214px}.teaching-part{min-width:42px}.teaching-part svg{width:46px!important;height:46px!important}}
.prophetic-card{background:radial-gradient(circle at 50% 42%,rgba(216,193,124,.055),rgba(14,18,24,.56) 60%);border-color:rgba(216,193,124,.16)}
.prophetic-card svg{width:92px!important;height:92px!important;filter:drop-shadow(0 0 7px rgba(216,193,124,.08))}
.prophetic-separator{align-self:center;color:rgba(216,193,124,.42);font-size:20px;padding:0 2px}
.inscription-workbench{display:grid;grid-template-columns:minmax(240px,.78fr) minmax(0,1.6fr);gap:18px;align-items:start}
.inscription-list-card{position:sticky;top:88px;max-height:calc(100vh - 120px);overflow:hidden;display:flex;flex-direction:column}
.inscription-list-scroll{overflow:auto;margin-top:12px;padding-right:4px}
.inscription-list-item{width:100%;text-align:left;padding:13px 4px;border:0;border-bottom:1px solid var(--border-soft);background:transparent;display:grid;gap:6px;color:var(--text)}
.inscription-list-item:hover{color:var(--accent-strong)}
.inscription-list-item.active{background:linear-gradient(90deg,rgba(216,193,124,.07),transparent 75%);color:var(--accent-strong)}
.inscription-list-item .top{display:flex;align-items:center;justify-content:space-between;gap:9px}
.inscription-list-item .truth{font-size:11px;line-height:1.45;color:var(--muted);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.inscription-detail{display:grid;gap:16px}
.inscription-hero{display:grid;gap:13px;padding:18px;border:1px solid var(--border-soft);border-radius:16px;background:radial-gradient(circle at 50% 5%,rgba(216,193,124,.045),transparent 34%),rgba(13,17,22,.48)}
.inscription-preview-line{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:13px;min-height:160px;padding:15px 8px}
.inscription-preview-glyph{display:grid;place-items:center;min-width:105px;min-height:122px;padding:10px;border-radius:14px;background:rgba(14,18,24,.5);border:1px solid rgba(255,255,255,.045)}
.inscription-preview-glyph svg{width:76px!important;height:76px!important}
.inscription-preview-glyph .word{font-size:10px;margin-top:5px;color:#d9dee5;font-weight:700}
.inscription-preview-glyph .role{font-size:8px;margin-top:3px;color:#677482;letter-spacing:.07em;text-transform:uppercase}
.inscription-hero.prophetic{background:radial-gradient(circle at 50% 45%,rgba(216,193,124,.075),transparent 35%),rgba(10,14,19,.72)}
.inscription-hero.prophetic .inscription-preview-glyph{background:transparent;border:0;min-width:86px}
.inscription-hero.prophetic .inscription-preview-glyph .word,.inscription-hero.prophetic .inscription-preview-glyph .role{display:none}
.inscription-hero.prophetic .inscription-preview-glyph svg{width:92px!important;height:92px!important;filter:drop-shadow(0 0 8px rgba(216,193,124,.1))}
.inscription-meta-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.inscription-meta-grid .panel{min-height:108px}
.inscription-edit-grid{display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:12px}
.inscription-action-row{display:flex;gap:9px;align-items:center;flex-wrap:wrap;padding-top:2px}
.inscription-locked{font-size:11px;color:var(--muted);padding:10px 12px;border:1px solid var(--border-soft);border-radius:10px;background:rgba(255,255,255,.018)}
.player-inscription-strip{display:flex;align-items:center;justify-content:center;gap:11px;flex-wrap:wrap;margin-top:12px;padding:14px;border-radius:15px;background:radial-gradient(circle at 50% 50%,rgba(216,193,124,.04),transparent 60%),rgba(8,12,17,.42)}
.player-inscription-strip.prophetic{min-height:150px;gap:18px;background:radial-gradient(circle at 50% 50%,rgba(216,193,124,.07),transparent 46%),rgba(7,10,15,.64)}
.player-inscription-unit{display:grid;place-items:center;gap:5px;min-width:78px}
.player-inscription-unit svg{width:62px!important;height:62px!important}
.player-inscription-unit .reading{font-size:9px;color:var(--muted);text-align:center;max-width:100px;line-height:1.3}
.player-inscription-strip.prophetic .reading{display:none}
.player-inscription-strip.prophetic .player-inscription-unit svg{width:82px!important;height:82px!important;filter:drop-shadow(0 0 7px rgba(216,193,124,.08))}
@media(max-width:980px){.inscription-workbench{grid-template-columns:1fr}.inscription-list-card{position:relative;top:auto;max-height:none}.inscription-list-scroll{max-height:330px}.inscription-edit-grid,.inscription-meta-grid{grid-template-columns:1fr}}
/* Optional informational rails are hidden by default to reduce clutter */
.optional-rail{display:none!important}.app.details-open .optional-rail{display:grid!important}.app.details-open aside.optional-rail.card{display:block!important}
/* Compact helper details */
details.helper{border-top:1px solid var(--border-soft);padding-top:12px}details.helper summary{cursor:pointer;color:var(--muted);font-size:12px}details.helper>div{padding-top:10px}
.focus-actions{display:flex;align-items:center;gap:8px}.top-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}
#detailsToggle{white-space:nowrap}
.player-bubble-stage{position:relative;min-height:560px;overflow:hidden;border-radius:22px;border:1px solid rgba(216,193,124,.16);background:radial-gradient(circle at 50% 35%,rgba(234,214,149,.07),transparent 26%),radial-gradient(circle at 18% 18%,rgba(255,255,255,.035),transparent 20%),radial-gradient(circle at 82% 78%,rgba(216,193,124,.05),transparent 24%),linear-gradient(180deg,rgba(17,22,29,.96),rgba(10,14,20,.98));box-shadow:inset 0 1px 0 rgba(255,255,255,.03), var(--shadow)}
.player-bubble-stage:before{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 20% 30%,rgba(216,193,124,.06),transparent 11%),radial-gradient(circle at 70% 55%,rgba(255,255,255,.03),transparent 12%),radial-gradient(circle at 45% 82%,rgba(216,193,124,.045),transparent 12%)}
.glyph-cloud{position:relative;height:100%;min-height:560px;padding:18px}
.glyph-bubble{position:absolute;display:grid;place-items:center;gap:6px;border-radius:999px;border:1px solid rgba(216,193,124,.14);background:radial-gradient(circle at 35% 28%,rgba(255,255,255,.11),rgba(255,255,255,.045) 35%,rgba(17,22,29,.8) 72%);box-shadow:0 14px 40px rgba(0,0,0,.26), inset 0 1px 0 rgba(255,255,255,.08), inset 0 -8px 22px rgba(0,0,0,.24);backdrop-filter:blur(10px);transform:translate3d(0,0,0);color:var(--text);transition:border-color .2s ease,box-shadow .2s ease;cursor:grab;user-select:none;touch-action:none;will-change:transform}
.glyph-bubble:hover,.glyph-bubble.active{border-color:rgba(234,214,149,.55);box-shadow:0 20px 44px rgba(0,0,0,.3),0 0 0 1px rgba(234,214,149,.18),0 0 18px rgba(234,214,149,.14),inset 0 1px 0 rgba(255,255,255,.12)}
.glyph-bubble.dragging{cursor:grabbing;border-color:rgba(255,237,182,.75);box-shadow:0 24px 54px rgba(0,0,0,.34),0 0 0 1px rgba(255,240,188,.24),0 0 24px rgba(234,214,149,.2),inset 0 1px 0 rgba(255,255,255,.16)}
.glyph-bubble svg{width:56%;height:56%;color:#f5f2e7;filter:drop-shadow(0 2px 5px rgba(0,0,0,.22))}
.glyph-bubble .bubble-label{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.bubble-detail{min-height:190px;background:linear-gradient(180deg,rgba(22,27,35,.94),rgba(16,20,27,.96));border:1px solid rgba(216,193,124,.14);border-radius:18px;padding:20px}
.bubble-detail .hero{display:flex;align-items:center;gap:16px;flex-wrap:wrap}.bubble-detail .hero svg{width:92px;height:92px}
.bubble-detail .meta-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:14px}.bubble-detail .meta{background:#12171d;border-radius:12px;padding:12px}
@keyframes floatDrift{0%,100%{transform:translate3d(var(--x1,0px),var(--y1,0px),0)}50%{transform:translate3d(var(--x2,12px),var(--y2,-14px),0)}}
.draw-stage{background:linear-gradient(180deg,#faf3df,#f1e0bb);border:1px solid rgba(90,69,28,.22);border-radius:22px;padding:18px;box-shadow:0 22px 50px rgba(0,0,0,.22), inset 0 0 0 1px rgba(255,255,255,.2);position:relative;overflow:hidden}
.draw-stage:before{content:'';position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(180deg,rgba(90,69,28,.025) 0,rgba(90,69,28,.025) 2px,transparent 3px,transparent 20px),radial-gradient(circle at 20% 10%,rgba(255,255,255,.34),transparent 28%)}
.calligraphy-wrap{position:relative;z-index:1}

.correction-guide{margin-top:14px;padding:12px;border:1px solid rgba(216,193,124,.18);border-radius:14px;background:rgba(8,12,22,.48)}
.correction-guide-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:10px}
.correction-guide-title{font-weight:700;color:var(--text)}
.correction-guide-sub{font-size:12px;color:var(--muted);margin-top:3px;line-height:1.4}
.correction-guide-body{display:grid;grid-template-columns:minmax(150px,210px) 1fr;gap:14px;align-items:center}
.correction-guide svg{width:100%;height:auto;display:block;border-radius:12px;background:rgba(4,7,13,.62)}
.correction-legend{display:grid;gap:8px;font-size:12px;color:var(--muted)}
.correction-legend-row{display:flex;gap:8px;align-items:center}
.guide-swatch{width:24px;height:0;border-top:3px solid rgba(235,245,255,.7);border-radius:999px;flex:none}
.guide-swatch.missing{border-color:#f0d88f;box-shadow:0 0 8px rgba(240,216,143,.3)}
.guide-swatch.extra{border-color:#7699c8;border-top-style:dashed}
.correction-stats{margin-top:4px;font-size:11px;color:var(--muted)}
@media(max-width:650px){.correction-guide-body{grid-template-columns:1fr}.correction-guide svg{max-width:220px;margin:0 auto}}

#drawCanvas{height:420px;background:transparent;border:0;border-radius:16px;box-shadow:none}
.draw-stage.glowing{box-shadow:0 22px 50px rgba(0,0,0,.22),0 0 0 1px rgba(234,214,149,.28),0 0 30px rgba(216,193,124,.22),inset 0 0 0 1px rgba(255,255,255,.22)}
.ink-hint{font-size:12px;color:#5d5030}.ink-hint b{color:#403416}.draw-result-card{background:rgba(18,22,28,.8);border:1px solid rgba(216,193,124,.12);border-radius:18px;padding:18px}

/* Magical player-side atmosphere */
#playerLexicon .card:first-child{position:relative;overflow:hidden}
#playerLexicon .card:first-child:before{content:'';position:absolute;inset:-20%;pointer-events:none;background:
 radial-gradient(circle at 20% 20%,rgba(234,214,149,.08),transparent 16%),
 radial-gradient(circle at 80% 30%,rgba(216,193,124,.05),transparent 18%),
 radial-gradient(circle at 55% 85%,rgba(234,214,149,.045),transparent 16%);animation:arcaneBreathe 10s ease-in-out infinite alternate}
.player-bubble-stage{isolation:isolate}
.player-bubble-stage:after{content:'';position:absolute;inset:0;pointer-events:none;z-index:0;background-image:
 radial-gradient(circle,rgba(234,214,149,.42) 0 1px,transparent 1.6px),
 radial-gradient(circle,rgba(255,255,255,.2) 0 1px,transparent 1.5px);
 background-size:140px 140px,210px 210px;background-position:12px 28px,80px 120px;opacity:.26;animation:starDrift 26s linear infinite}
.glyph-cloud{z-index:1;touch-action:none}
.glyph-bubble:before{content:'';position:absolute;inset:9%;border-radius:50%;border:1px solid rgba(234,214,149,.08);box-shadow:inset 0 0 24px rgba(234,214,149,.03);pointer-events:none}
.glyph-bubble:after{content:'';position:absolute;width:4px;height:4px;border-radius:50%;background:rgba(255,235,167,.85);box-shadow:0 0 8px rgba(255,224,135,.65);right:18%;top:16%;opacity:.35;animation:sparkBlink 3.8s ease-in-out infinite}
.glyph-bubble:hover svg,.glyph-bubble.active svg{color:#fff3c2;filter:drop-shadow(0 0 7px rgba(234,214,149,.58)) drop-shadow(0 2px 5px rgba(0,0,0,.22))}
.bubble-detail{position:relative;overflow:hidden}
.bubble-detail:before{content:'';position:absolute;inset:-40% -20%;pointer-events:none;background:conic-gradient(from 0deg,transparent,rgba(234,214,149,.025),transparent 35%);animation:slowTurn 18s linear infinite}
.bubble-detail>*{position:relative;z-index:1}

#playerArchiveList .archive-row{position:relative;margin-bottom:18px;padding:18px 18px 20px;border:1px solid rgba(216,193,124,.12);border-radius:18px;background:
 linear-gradient(180deg,r