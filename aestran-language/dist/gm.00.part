<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Aestran Language — Campaign Decoder</title>
<style>
:root{
  --bg:#0c0f13;--bg2:#11151b;--sidebar:#10141a;--panel:#151a21;--card:#181e26;--card2:#202730;
  --text:#f2f0e8;--muted:#929ca7;--faint:#67717c;--border:#2b333d;--border-soft:#222a33;
  --accent:#d8c17c;--accent-strong:#ead695;--accent-bg:#252219;--good:#90b79a;--warn:#d2ac6f;--bad:#c78080;
  --shadow:0 18px 50px rgba(0,0,0,.22);--radius:16px;
}
*{box-sizing:border-box}
html{background:var(--bg)}
body{margin:0;background:
  radial-gradient(circle at 78% -10%,rgba(216,193,124,.07),transparent 30%),
  radial-gradient(circle at 15% 115%,rgba(90,110,135,.06),transparent 34%),var(--bg);
  color:var(--text);font:14px/1.55 Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
button,input,select,textarea{font:inherit;color:inherit}button{cursor:pointer}
.app{min-height:100vh;display:grid;grid-template-columns:198px minmax(0,1fr)}
.sidebar{border-right:1px solid var(--border-soft);background:rgba(16,20,26,.94);padding:24px 15px 18px;position:sticky;top:0;height:100vh;overflow:auto;backdrop-filter:blur(18px)}
.brand{font-size:17px;font-weight:800;letter-spacing:.025em;padding:0 8px}.brand:before{content:'◇';color:var(--accent);margin-right:9px;font-size:14px}
.sub{color:var(--muted);font-size:11px;margin-top:4px;padding:0 8px}
.nav{margin-top:30px;display:grid;gap:3px}.nav-group{margin:18px 9px 6px;color:var(--faint);font-size:9px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}.nav-group:first-child{margin-top:0}
.nav button{border:0;background:transparent;text-align:left;padding:9px 10px;border-radius:9px;color:#b7bec7;display:flex;align-items:center;gap:9px;transition:.15s ease}.nav button:before{content:attr(data-icon);width:16px;text-align:center;color:var(--faint);font-size:13px}.nav button:hover{background:rgba(255,255,255,.035);color:var(--text)}.nav button.active{background:rgba(216,193,124,.09);color:var(--text)}.nav button.active:before{color:var(--accent)}
.side-bottom{margin-top:28px;border-top:1px solid var(--border-soft);padding:16px 6px 0;display:grid;gap:7px}.side-bottom button{width:100%;border:0;background:transparent;color:var(--muted);padding:8px;border-radius:8px;text-align:left;font-size:12px}.side-bottom button:hover{background:rgba(255,255,255,.035);color:var(--text)}
.main{padding:34px clamp(24px,4vw,58px) 60px;min-width:0;max-width:1580px;width:100%;margin:0 auto}
.topbar{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:30px;padding-bottom:18px;border-bottom:1px solid var(--border-soft)}
h1{font-size:25px;line-height:1.2;margin:0;letter-spacing:-.025em}h2{font-size:17px;margin:0}h3{font-size:10px;margin:0;text-transform:uppercase;letter-spacing:.13em;color:var(--muted);font-weight:800}
.muted{color:var(--muted)}
.grid2{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:28px;align-items:start}.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.card{background:linear-gradient(180deg,rgba(27,33,42,.94),rgba(22,27,35,.94));border:1px solid var(--border-soft);border-radius:var(--radius);padding:20px;box-shadow:0 1px 0 rgba(255,255,255,.018)}
.panel{background:rgba(20,25,32,.72);border:1px solid var(--border-soft);border-radius:14px;padding:18px}
.grid2>aside.card,.grid2>aside.stack>.card{background:transparent;border:0;border-left:1px solid var(--border-soft);border-radius:0;padding:3px 0 3px 20px;box-shadow:none}.grid2>aside.stack{gap:24px}.grid2>aside.stack>.card+ .card{padding-top:21px;border-top:1px solid var(--border-soft)}
.field{display:block}.field span{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin-bottom:7px;font-weight:750}
input,select,textarea{width:100%;background:#11161c;border:1px solid var(--border);border-radius:10px;padding:10px 12px;outline:none;transition:.15s ease}input:focus,select:focus,textarea:focus{border-color:#645b40;box-shadow:0 0 0 3px rgba(216,193,124,.06)}textarea{resize:vertical;line-height:1.55}
.btn{border:1px solid var(--border);background:#151a21;padding:9px 12px;border-radius:9px;transition:.15s ease}.btn:hover{background:#1a2028;border-color:#3a4551}.btn.primary{background:var(--accent);border-color:var(--accent);color:#14120c;font-weight:750;outline:0}.btn.primary:hover{background:var(--accent-strong)}.btn.good{background:#1f2a23;border-color:#405948}.btn.bad{background:#2a2020;border-color:#5e4040}.btn.ghost{background:transparent;border-color:var(--border-soft);color:var(--muted)}
.row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.stack{display:grid;gap:16px}
.pill{display:inline-flex;border:1px solid var(--border);border-radius:999px;padding:4px 9px;font-size:10px;color:var(--muted);letter-spacing:.04em}.pill.good{border-color:#405447;color:#b8d4be}.pill.warn{border-color:#625236;color:#ddc28d}.pill.bad{border-color:#624040;color:#dda5a5}
.screen{display:none}.screen.active{display:block;animation:screenIn .16s ease}@keyframes screenIn{from{opacity:.35;transform:translateY(3px)}to{opacity:1;transform:none}}
.glyph-grid{display:flex;flex-wrap:wrap;gap:13px;align-items:center}.glyph-card{min-width:120px;max-width:145px;background:rgba(14,18,24,.65);border:1px solid var(--border-soft);border-radius:14px;padding:14px 10px;text-align:center}.glyph-card svg{width:80px;height:80px;display:block;margin:auto}.glyph-card:hover{border-color:#3b4550;background:#11171e}
svg path,svg circle,svg line,svg rect,svg ellipse{fill:none;stroke:currentColor;stroke-width:3.25;stroke-linecap:round;stroke-linejoin:round;vector-effect:non-scaling-stroke}
.meaning-row,.change-row,.archive-row,.lex-row{border:0;border-bottom:1px solid var(--border-soft);background:transparent;border-radius:0;padding:13px 2px}.meaning-row:last-child,.change-row:last-child,.archive-row:last-child,.lex-row:last-child{border-bottom:0}
.semantic-row{display:grid;grid-template-columns:130px minmax(170px,1fr) 120px;gap:14px;align-items:center;border:0;background:#12171d;padding:12px 14px;border-radius:11px}
.semantic-wrap{display:grid;gap:8px}.construct-btn{border:1px solid #6a5633;background:#2a2418;color:#e7ca87;border-radius:999px;padding:5px 9px;font-size:10px;font-weight:800;letter-spacing:.03em}.construct-btn:hover{background:#342b1a;border-color:#8b7141}.construction-panel{border:1px solid rgba(216,193,124,.2);background:linear-gradient(180deg,rgba(29,30,31,.96),rgba(20,24,29,.96));border-radius:14px;padding:15px;box-shadow:inset 0 1px 0 rgba(255,255,255,.02)}.construction-panel .construction-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.construction-tabs{display:flex;gap:6px;margin-top:12px;flex-wrap:wrap}.construction-tabs button{border:1px solid var(--border-soft);background:#151a21;color:var(--muted);border-radius:8px;padding:7px 10px;font-size:11px}.construction-tabs button.active{color:#17130a;background:var(--accent);border-color:var(--accent);font-weight:800}.construction-body{margin-top:13px}.suggestion-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.suggestion-card{border:1px solid var(--border-soft);border-radius:12px;background:#12171d;padding:12px;display:grid;gap:8px;align-content:start}.suggestion-card svg{width:58px!important;height:58px!important;margin:auto}.suggestion-card .suggestion-name{text-align:center;font-weight:800;font-size:12px}.suggestion-card .suggestion-desc{color:var(--muted);font-size:10px;line-height:1.45;text-align:center}.manual-construction{display:grid;grid-template-columns:minmax(0,1fr) 130px minmax(0,1fr);gap:9px;align-items:end}.construction-preview{display:grid;place-items:center;min-height:120px;margin-top:12px;border:1px solid var(--border-soft);border-radius:12px;background:#10151b}.construction-preview svg{width:96px!important;height:96px!important}.new-root-grid{display:grid;grid-template-columns:140px minmax(0,1fr);gap:9px}.construction-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.construction-note{font-size:11px;color:var(--muted);line-height:1.5;margin-top:8px}@media(max-width:850px){.suggestion-grid{grid-template-columns:1fr}.manual-construction,.new-root-grid{grid-template-columns:1fr}}
.clause-map{display:grid;gap:9px;margin-top:14px}.clause-lane{display:grid;grid-template-columns:90px minmax(0,1fr);gap:10px;align-items:start;padding:10px 12px;border:1px solid var(--border-soft);border-radius:11px;background:#10151b}.clause-label{font-size:10px;letter-spacing:.09em;text-transform:uppercase;color:var(--accent);font-weight:800;padding-top:3px}.clause-flow{display:flex;align-items:center;gap:7px;flex-wrap:wrap}.clause-token{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border-soft);border-radius:999px;padding:5px 8px;background:#151b22;font-size:11px}.clause-token b{font-size:9px;color:var(--muted);letter-spacing:.08em}.clause-arrow{color:#596573;font-size:11px}.semantic-role{display:inline-flex;margin-top:5px;border:1px solid #39434e;border-radius:999px;padding:2px 6px;font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:#aeb9c5}.modifier-row{display:flex;gap:5px;flex-wrap:wrap;margin-top:6px}.modifier-chip{border:1px solid rgba(152,188,235,.26);background:rgba(95,132,183,.08);border-radius:999px;padding:2px 6px;font-size:9px;color:#b8d3f5;letter-spacing:.04em}.glyph-card .grammar-label{font-size:9px;letter-spacing:.07em;text-transform:uppercase;color:#748190;margin-top:4px}.grammar-key{display:grid;gap:8px}.grammar-key .gitem{padding:9px 10px;border:1px solid var(--border-soft);border-radius:10px;background:#12171d}.grammar-key b{font-size:11px}.grammar-key .muted{font-size:10px;line-height:1.4;margin-top:3px}@media(max-width:700px){.clause-lane{grid-template-columns:1fr}.clause-label{padding-top:0}}

.two-col{display:grid;grid-template-columns:1fr 1fr;gap:14px}.audit-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}.audit-card{background:#12171d;border:1px solid var(--border-soft);border-radius:12px;padding:11px 7px;text-align:center}.audit-card svg{width:66px;height:66px}.audit-card.reviewed{border-color:#31463a}.audit-card button{margin-top:6px;width:100%;font-size:10px;padding:6px 8px}

.rune-review-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}.rune-review-head>div:first-child{max-width:720px}.rune-review-controls{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}.rune-review-controls .btn.active{background:rgba(216,193,124,.13);border-color:rgba(216,193,124,.45);color:var(--accent)}
.rune-review-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:16px}.review-stat{padding:10px 12px;border:1px solid var(--border-soft);border-radius:11px;background:#10151b}.review-stat b{display:block;font-size:17px}.review-stat span{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.07em}
.rune-review-grid{display:grid;grid-template-columns:repeat(4,minmax(150px,1fr));gap:12px;margin-top:16px}.rune-review-card{position:relative;border:1px solid var(--border-soft);border-radius:15px;background:linear-gradient(180deg,#12171d,#0f141a);padding:11px;color:var(--text);text-align:left;min-width:0;transition:border-color .15s ease,transform .15s ease,background .15s ease}.rune-review-card:hover{border-color:#3d4955;background:#131a22;transform:translateY(-1px)}.rune-review-card.selected{border-color:rgba(216,193,124,.5);box-shadow:0 0 0 1px rgba(216,193,124,.08)}.rune-review-card.issue{border-color:rgba(216,169,93,.34)}.rune-review-card.reviewed{box-shadow:inset 0 0 0 1px rgba(83,137,105,.14)}
.rune-grid-frame{aspect-ratio:1;display:grid;place-items:center;border:1px solid rgba(255,255,255,.035);border-radius:11px;background:#0b1016;overflow:hidden}.rune-grid-svg{width:100%!important;height:100%!important;color:#f1eee6}.rune-grid-svg .grid-line{stroke:rgba(150,171,195,.13);stroke-width:.65;stroke-linecap:butt}.rune-grid-svg .grid-axis{stroke:rgba(216,193,124,.18);stroke-width:.8}.rune-grid-svg .grid-dot{fill:rgba(185,207,231,.34);stroke:none}.rune-grid-svg .grid-dot.axis{fill:rgba(216,193,124,.48)}.rune-grid-svg .rune-path{stroke:#f1eee6;stroke-width:3.15;fill:none;stroke-linecap:round;stroke-linejoin:round}.rune-grid-svg .stroke-order-dot{fill:#d8c17c;stroke:#0b1016;stroke-width:1.2}.rune-grid-svg .stroke-order-num{fill:#0b1016;font-size:5.4px;font-weight:900;text-anchor:middle;dominant-baseline:central;pointer-events:none}.stroke-order-rule{margin-top:10px;padding:10px 11px;border:1px solid rgba(216,193,124,.16);border-radius:10px;background:rgba(216,193,124,.035);font-size:10px;line-height:1.45;color:var(--muted)}.stroke-order-rule b{color:var(--accent)}
.rune-review-meta{display:flex;justify-content:space-between;gap:8px;align-items:flex-start;margin-top:9px}.rune-review-name{font-size:12px;font-weight:850;letter-spacing:.03em}.rune-review-type{font-size:9px;text-transform:uppercase;letter-spacing:.08em;color:var(--faint);margin-top:2px}.rune-review-meaning{font-size:10px;color:var(--muted);line-height:1.35;margin-top:5px;min-height:27px}.rune-review-badges{display:flex;gap:5px;flex-wrap:wrap;margin-top:7px}.review-badge{font-size:9px;padding:2px 6px;border-radius:999px;border:1px solid var(--border-soft);color:var(--muted)}.review-badge.warn{color:#e0c386;border-color:rgba(216,193,124,.28);background:rgba(216,193,124,.05)}.review-badge.good{color:#9fc5aa;border-color:rgba(103,160,120,.24)}
.review-detail-grid{display:grid;place-items:center;max-width:250px;margin:auto}.review-detail-grid .rune-grid-frame{width:100%}.review-detail-facts{display:grid;gap:8px;margin-top:13px}.review-detail-fact{display:flex;justify-content:space-between;gap:12px;padding-bottom:7px;border-bottom:1px solid var(--border-soft);font-size:11px}.review-detail-fact span{color:var(--muted)}.review-neighbour{display:grid;grid-template-columns:58px 1fr;gap:10px;align-items:center;margin-top:12px;padding:10px;border:1px solid var(--border-soft);border-radius:11px;background:#10151b}.review-neighbour .rune-grid-frame{width:58px}.review-pairs{display:grid;gap:8px;margin-top:12px}.review-pair{display:grid;grid-template-columns:42px 42px 1fr;gap:7px;align-items:center;padding:8px;border-bottom:1px solid var(--border-soft)}.review-pair:last-child{border-bottom:0}.review-pair .rune-grid-frame{width:42px}.review-pair b{font-size:10px}.review-pair .muted{font-size:9px}
@media(max-width:1300px){.rune-review-grid{grid-template-columns:repeat(3,minmax(145px,1fr))}}@media(max-width:900px){.rune-review-head{flex-direction:column}.rune-review-controls{justify-content:flex-start}.rune-review-grid{grid-template-columns:repeat(2,minmax(140px,1fr))}.rune-review-summary{grid-template-columns:1fr 1fr 1fr}}@media(max-width:560px){.rune-review-grid{grid-template-columns:1fr 1fr}.rune-review-summary{grid-template-columns:1fr}.